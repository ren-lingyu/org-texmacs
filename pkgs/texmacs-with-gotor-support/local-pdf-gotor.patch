+// Probe only: recognize bare local PDF paths, not URI schemes or anchors.
+static bool
+probe_local_pdf (string s) {
+  int n= N(s);
+  if (n < 4 || starts (s, "//")) return false;
+  for (int i=0; i<n; i++)
+    if (s[i] == ':' || s[i] == '#' || s[i] == '?') return false;
+  return s[n-4] == '.' && (s[n-3] == 'p' || s[n-3] == 'P') &&
+    (s[n-2] == 'd' || s[n-2] == 'D') && (s[n-1] == 'f' || s[n-1] == 'F');
+}
+
+static string
+probe_pdf_hex (string s) {
+  static const char* digits= "0123456789ABCDEF";
+  string r= "<";
+  for (int i=0; i<N(s); i++) {
+    unsigned char c= (unsigned char) s[i];
+    r << string (digits[c >> 4]) << string (digits[c & 15]);
+  }
+  return r * ">";
+}
