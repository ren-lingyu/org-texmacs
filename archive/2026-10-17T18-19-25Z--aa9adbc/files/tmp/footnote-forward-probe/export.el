(require 'org-texmacs)
(setq org-texmacs-program (getenv "TEXMACS_PROGRAM"))
(let ((out (getenv "PROBE_OUT")))
  (dolist (style '("generic" "article"))
    (dolist (variant '("minimal" "paragraphs"))
      (with-temp-buffer
        (org-mode)
        (insert (if (equal variant "minimal") "1[fn::1]\n2[fn::2]\n"
                  "1[fn::1]\n\n2[fn::2]\n"))
        (let* ((org-texmacs-document-style (list style))
               (org-export-with-toc nil) (org-export-with-title nil)
               (org-export-with-author nil) (org-export-with-date nil)
               (source (buffer-string))
               (document (org-texmacs-document-from-buffer (current-buffer)))
               (name (expand-file-name (concat "org-" style "-" variant) out)))
          (unless (equal source (buffer-string)) (error "Source mutation"))
          (with-temp-file (concat name ".org") (insert source))
          (with-temp-file (concat name ".stree")
            (prin1 (org-texmacs-document-body document) (current-buffer)))
          (org-texmacs-document-save document (concat name ".tm"))
          (org-texmacs-document-save-pdf document (concat name "-package.pdf")))))))
