;;; prototype.el --- Phase 2a source provenance model -*- lexical-binding: t; -*-
(require 'org-texmacs)
(require 'org-texmacs-bibliography)

(defun p2-model (source base &optional before after)
  "Research model: protected owned mirror, native INCLUDE, occurrence origins."
  (let ((directory (make-temp-file "org-texmacs-composition-" t))
        (nonce (substring (secure-hash 'sha256 (format "%s%s" source (float-time))) 0 20))
        (org-mode-hook nil) (org-inhibit-startup t)
        (org-export-use-babel nil) (org-export-allow-bind-keywords nil)
        (org-export-replace-macros nil) (org-element-use-cache nil)
        (next 0) (total 0) origins islands receipts mirrors)
    (unwind-protect
        (cl-labels
            ((capture (file)
               (let* ((file-name-handler-alist nil)
                      (attrs (org-texmacs--bibliography-file-attributes file))
                      (bytes (org-texmacs--bibliography-file-bytes file))
                      (new (org-texmacs--bibliography-file-attributes file))
                      (text (decode-coding-string bytes 'utf-8-unix)))
                 (unless (and (equal attrs new) (<= (length bytes) 65536)
                              (equal bytes (encode-coding-string text 'utf-8-unix))
                              (not (cl-some (lambda (c) (> c #x10ffff)) text)))
                   (error "Changed/large/non-UTF-8 include"))
                 (push (list file attrs (secure-hash 'sha256 bytes)) receipts)
                 text))
             (protect (file occurrence)
               (let ((spans (mapcar
                             (lambda (span)
                               (cons (org-texmacs-fragment-span-begin span)
                                     (org-texmacs-fragment-span-end span)))
                             (org-texmacs--fragment-collect (org-texmacs--fragment-tags)))))
                 (org-element-map (org-element-parse-buffer) 'special-block
                   (lambda (node)
                     (when (org-texmacs--block-p node)
                       (push (cons (org-element-property :begin node)
                                   (org-element-property :end node)) spans))))
                 (dolist (span (sort spans (lambda (a b) (> (car a) (car b)))))
                   (let* ((raw (buffer-substring-no-properties (car span) (cdr span)))
                          (token (format "TXMSTM%sX%dX%d" nonce occurrence (length islands))))
                     (push (list token raw file occurrence (car span) (cdr span)) islands)
                     (delete-region (car span) (cdr span)) (goto-char (car span))
                     (insert token (if (string-suffix-p "\n" raw) "\n" ""))))))
             (materialize (text file ancestors depth)
               (when (or (> depth 8) (>= next 32)) (error "Composition budget"))
               (cl-incf total (string-bytes text))
               (when (> total 262144) (error "Composition text budget"))
               (let* ((occurrence (prog1 next (cl-incf next)))
                      (mirror (expand-file-name (format "source-%d.org" occurrence) directory)))
                 (push (list occurrence file) origins)
                 (with-temp-buffer
                   (org-mode) (setq-local default-directory base)
                   (insert text) (protect file occurrence)
                   (when (and (zerop occurrence) before) (funcall before 'texmacs))
                   (let ((includes (org-element-map (org-element-parse-buffer) 'keyword
                                     (lambda (node)
                                       (let ((key (org-element-property :key node)))
                                         (when (member key '("SETUPFILE" "BIND" "MACRO" "CITE_EXPORT"))
                                           (error "Unsupported directive"))
                                         (and (equal key "INCLUDE") node))))))
                     (dolist (node (reverse includes))
                       (let ((value (org-element-property :value node)))
                         (unless (string-match "\\`\"\\([^\"\n]+\\)\"[ \t]*\\'" value)
                           (error "Only bare quoted INCLUDE"))
                         (let* ((raw (match-string 1 value))
                                (id (org-texmacs--bibliography-local-path raw base)))
                           (unless (equal (file-name-directory id) base) (error "Include directory conflict"))
                           (when (member id ancestors) (error "Include cycle"))
                           (let ((child (materialize (capture id) id (cons id ancestors) (1+ depth))))
                             (goto-char (org-element-property :begin node))
                             (delete-region (point) (line-beginning-position 2))
                             (insert (format "#+INCLUDE: \"%s\"\n" child)))))))
                   (goto-char (point-min))
                   (insert (format "# TXMSTART%s:%d\n" nonce occurrence))
                   (goto-char (point-max)) (unless (bolp) (insert "\n"))
                   (insert (format "# TXMEND%s:%d\n" nonce occurrence))
                   (let ((coding-system-for-write 'utf-8-unix))
                     (write-region (point-min) (point-max) mirror nil 'silent))
                   (push (cons mirror (secure-hash 'sha256 (current-buffer))) mirrors))
                 mirror)))
          (let ((root (materialize source nil nil 0)) segments output)
            (with-temp-buffer
              (org-mode) (setq-local default-directory base)
              (insert-file-contents root)
              (org-export-expand-include-keyword nil directory nil root)
              (setq output (buffer-string)))
            (dolist (mirror mirrors)
              (with-temp-buffer
                (insert-file-contents (car mirror))
                (unless (equal (cdr mirror) (secure-hash 'sha256 (current-buffer)))
                  (error "Owned mirror changed"))))
            ;; Strip occurrence boundaries before Org's final parse.  Segment
            ;; intervals describe transformed text, not original char offsets.
            (with-temp-buffer
              (let ((input output) stack seen)
                (with-temp-buffer
                  (insert input) (goto-char (point-min))
                  (let ((start (point-min)))
                    (while (re-search-forward (format "^# TXM\\(START\\|END\\)%s:\\([0-9]+\\)\n" nonce) nil t)
                      (push (list 'text (buffer-substring start (match-beginning 0))) seen)
                      (push (list (intern (downcase (match-string 1)))
                                  (string-to-number (match-string 2))) seen)
                      (setq start (point)))
                    (push (list 'text (buffer-substring start (point-max))) seen)))
                (dolist (part (nreverse seen))
                  (pcase (car part)
                    ('start (push (cadr part) stack))
                    ('end (unless (eq (pop stack) (cadr part)) (error "Origin boundary changed")))
                    ('text
                     (when (> (length (cadr part)) 0)
                       (unless stack (error "Unknown source origin"))
                       (let ((begin (point)))
                         (insert (cadr part))
                         (add-text-properties begin (point)
                           (list 'p2-origin (car stack) 'rear-nonsticky t))
                         (push (list begin (point) (car stack)
                                     (cadr (assq (car stack) origins))) segments))))))
                (when stack (error "Unclosed origin")))
              (org-mode)
              (let ((after-change-functions
                     (list (lambda (begin end _old)
                             (let ((inhibit-modification-hooks t))
                               (put-text-property begin end 'p2-origin -1))))))
                (when after (funcall after 'texmacs)))
              (setq output (buffer-string)))
            (dolist (island islands)
              (with-temp-buffer
                (insert output) (goto-char (point-min))
                (unless (search-forward (car island) nil t) (error "STM marker lost"))
                (replace-match (if (string-suffix-p "\n" (nth 1 island))
                                   (substring (nth 1 island) 0 -1) (nth 1 island)) t t)
                (when (search-forward (car island) nil t) (error "STM marker duplicated"))
                (setq output (buffer-string))))
            (with-temp-buffer
              (insert output)
              (setq segments nil)
              (let ((position (point-min)))
                (while (< position (point-max))
                  (let* ((occurrence (or (get-text-property position 'p2-origin) -1))
                         (end (next-single-property-change position 'p2-origin nil (point-max))))
                    (push (list position end occurrence (cadr (assq occurrence origins))) segments)
                    (setq position end))))
              (setq output (buffer-substring-no-properties (point-min) (point-max))))
            (org-texmacs--bibliography-check-receipts receipts)
            (list :source output :segments (nreverse segments) :islands islands
                  :origins (nreverse origins) :receipts receipts)))
      (delete-directory directory t))))
