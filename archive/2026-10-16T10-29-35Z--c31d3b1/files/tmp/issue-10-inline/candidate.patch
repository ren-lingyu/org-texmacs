+(ert-deftest org-texmacs-document-issue10-owned-forward-and-scoped ()
+  :tags '(issue10)
+  (dolist (scope '(full selected subtree region narrowed))
+    (let (input requests)
+      (with-temp-buffer
+        (org-mode)
+        (insert "#+OPTIONS: toc:nil title:nil author:nil date:nil\n"
+                "* Hidden\nHidden[fn:n:Before (math \"x\") [[file:note.txt][File]] (math \"y\")].\n"
+                "Unused[fn:u:(math \"unused\")].\n"
+                "* Visible :keep:\nA[fn:n] repeat[fn:n].\n")
+        (setq-local default-directory "/base/")
+        (when (eq scope 'selected) (goto-char 1) (insert "#+SELECT_TAGS: keep\n"))
+        (goto-char (point-min)) (search-forward "* Visible") (beginning-of-line)
+        (let ((begin (point)) (end (point-max)))
+          (when (eq scope 'narrowed) (narrow-to-region begin end))
+          (cl-letf (((symbol-function 'org-texmacs--worker-request)
+                     (lambda (raw)
+                       (push raw requests)
+                       (cond ((string-match-p "unused" raw) '(math "unused"))
+                             ((string-match-p "x" raw) '(math "x"))
+                             (t '(math "y")))))
+                    ((symbol-function 'org-footnote-get-definition)
+                     (lambda (&rest _) (ert-fail "Definition source fallback"))))
+            (let ((before (org-texmacs-test--document-buffer-state (current-buffer))))
+              (setq input (org-texmacs-prepare-buffer
+                           (current-buffer) nil (and (eq scope 'subtree) begin)
+                           (and (eq scope 'region) (cons begin end))))
+              (should (equal before (org-texmacs-test--document-buffer-state (current-buffer))))))))
+      (should (equal (reverse requests)
+                     (append '("(math \"x\")" "(math \"y\")")
+                             (and (eq scope 'full) '("(math \"unused\")")))))
+      (unless (eq scope 'full) (should-not (member "(math \"unused\")" requests)))
+      ;; The source buffer is already dead; both pure conversions must succeed.
+      (cl-letf (((symbol-function 'org-texmacs--worker-request)
+                 (lambda (&rest _) (ert-fail "Owned lowering requested worker")))
+                ((symbol-function 'buffer-substring-no-properties)
+                 (lambda (&rest _) (ert-fail "Owned lowering read buffer"))))
+        (let* ((first (org-texmacs-document input)) (second (org-texmacs-document input))
+               (body (org-texmacs-document-body first)))
+          (should (equal body (org-texmacs-document-body second)))
+          (should (= (length (org-texmacs-document-stm-paths first)) (if (eq scope 'full) 3 2)))
+          (should (= (length (org-texmacs-document-file-paths first)) 1))
+          (should (= (cl-count 'footnote (flatten-tree body)) (if (eq scope 'full) 2 1)))
+          (should (memq 'reference (flatten-tree body)))
+          (should (string-match-p "/base/note.txt" (org-texmacs--native-document-wire first))))))))
