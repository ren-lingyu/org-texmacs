+(ert-deftest org-texmacs-fragment-issue10-discovery ()
+  :tags '(issue10)
+  (dolist (prefix '("[fn::" "[fn:n:"))
+    (with-temp-buffer
+      (org-mode)
+      (insert "A" prefix "Before (math \"x\") after (math \"y\")].\n")
+      (let ((before (org-texmacs-test--document-buffer-state (current-buffer))))
+        (cl-letf (((symbol-function 'org-texmacs--worker-request)
+                   (lambda (&rest _) (ert-fail "Discovery started worker"))))
+          (let ((spans (org-texmacs-fragment-map (point-min) (point-max) #'identity)))
+            (should (equal (mapcar #'org-texmacs-fragment-span-source spans)
+                           '("(math \"x\")" "(math \"y\")")))
+            (dolist (span spans)
+              (should (equal (org-texmacs-fragment-span-source
+                              (org-texmacs-fragment-at-point (org-texmacs-fragment-span-begin span)))
+                             (org-texmacs-fragment-span-source span))))))
+        (should (equal before (org-texmacs-test--document-buffer-state (current-buffer))))))))
+
+(ert-deftest org-texmacs-document-issue10-pure-bare ()
+  :tags '(issue10)
+  (dolist (tree (append org-texmacs-test--fragment-strees
+                       '((with "mode" "math" "x") "atomic" " " "")))
+    (let* ((leaf (copy-sequence "island"))
+           (note (org-element-create 'footnote-reference '(:type inline)
+                                     " \t" leaf "\r\n"))
+           (ast (org-element-create 'org-data nil (org-element-create 'paragraph nil "A" note)))
+           (input (org-texmacs-input-create ast nil :islands (list (cons leaf tree)))))
+      (cl-letf (((symbol-function 'org-texmacs--worker-request)
+                 (lambda (&rest _) (ert-fail "Pure lowering started worker")))
+                ((symbol-function 'buffer-substring-no-properties)
+                 (lambda (&rest _) (ert-fail "Pure lowering read buffer"))))
+        (let ((document (org-texmacs-document input)))
+          (should (equal (org-texmacs-document-body document)
+                         `(document (concat "A" (footnote (document ,tree))))))
+          (should (equal (org-texmacs-document-stm-paths document) '((0 1 0 0)))))))))
+
+(ert-deftest org-texmacs-fragment-issue10-object-and-delimiter-boundaries ()
+  :tags '(issue10)
+  (dolist (body '("(math \"~x\") ~tail~"
+                  "*bold* (math \"[x]\") [[https://example.org][link]]"
+                  "(math\n (frac \"1\" \"2\")) ~literal~"
+                  "~(math \"code\")~ (math \"yes\")"
+                  "*(math \"bold\")* (math \"yes\")"
+                  "[[https://example.org][(math \"link\")]] (math \"yes\")"))
+    (with-temp-buffer
+      (org-mode) (insert "A[fn::" body "].\n")
+      (let ((spans (org-texmacs-fragment-map (point-min) (point-max) #'identity)))
+        (should (= (length spans) 1))
+        (should-not (string-match-p "code\\|bold\\|link"
+                                    (org-texmacs-fragment-span-source (car spans)))))
+      (cl-letf (((symbol-function 'org-texmacs--worker-request)
+                 (lambda (_source) '(math "accepted"))))
+        (should (= (length (org-texmacs-document-stm-paths
+                            (org-texmacs-document-from-buffer (current-buffer)))) 1)))))
+  (with-temp-buffer
+    (org-mode) (insert "A[fn::(with \"mode\" \"math\" \"x\")].\n")
+    (let ((org-texmacs-fragment-tags '("with")))
+      (should (= (length (org-texmacs-fragment-map (point-min) (point-max) #'identity)) 1)))
+    (let ((org-texmacs-fragment-tags nil))
+      (should-not (org-texmacs-fragment-map (point-min) (point-max) #'identity)))))
+
