;;; probes.el --- Adjacent PDF native controls -*- lexical-binding: t; -*-
(defvar pa-output (getenv "PROBE_OUTPUT"))
(defun pa-write (name text)
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file (expand-file-name name pa-output) (insert text))))
(defun pa-reload (tm pdf passes name)
  (let ((script (expand-file-name (concat name ".scm") pa-output))
        (process-environment (copy-sequence process-environment)))
    (setenv "TEXMACS_HOME_PATH" (expand-file-name (concat name "-config") temporary-file-directory))
    (pa-write (concat name ".scm")
              (format "(use-modules (generic document-edit))\n(begin (catch #t (lambda () (load-buffer (system->url %S)) (do ((pass 0 (+ pass 1))) ((= pass %d)) (update-current-buffer) (update-forced) (print-to-file (system->url %S))) (display \"ADJACENT-OK\\n\")) (lambda args (display \"ADJACENT-ERROR\") (write args))) (quit-TeXmacs))\n" tm passes pdf))
    (with-temp-buffer
      (let ((status (call-process "timeout" nil t nil "30s" org-texmacs-program "-H" "-s" "-x" (format "(load %S)" script))))
        (pa-write (concat name ".log") (buffer-string))
        (should (= status 0))
        (should (string-match-p "ADJACENT-OK" (buffer-string)))
        (should (file-exists-p pdf))))))
(org-texmacs-test--with-worker
  (pa-write "refs.bib" org-texmacs-test--adjacent-bib)
  (dolist (style '("generic" "article"))
    (dolist (long '(nil t))
      (let* ((stem (format "%s-%s" style (if long "flow" "short")))
             (source (org-texmacs-test--adjacent-source long))
             (tm (expand-file-name (concat stem ".tm") pa-output))
             (pdf (expand-file-name (concat stem "-direct.pdf") pa-output))
             document)
        (pa-write (concat stem ".org") source)
        (with-temp-buffer
          (org-mode)
          (insert source)
          (let ((org-texmacs-document-style (list style))
                (before (org-texmacs-test--document-buffer-state (current-buffer))))
            (setq document (org-texmacs-document-from-buffer
                            (current-buffer) `(("refs.bib" . ,org-texmacs-test--adjacent-bib))))
            (should (equal before (org-texmacs-test--document-buffer-state (current-buffer))))))
        (pa-write (concat stem "-tree.sexp") (prin1-to-string (org-texmacs-document-body document)))
        (org-texmacs-document-save document tm)
        (org-texmacs-document-save-pdf document pdf)
        (dolist (passes '(2 6))
          (let* ((name (format "%s-reload-%d" stem passes))
                 (reload (expand-file-name (concat name ".pdf") pa-output)))
            (pa-reload tm reload passes name)))))))
