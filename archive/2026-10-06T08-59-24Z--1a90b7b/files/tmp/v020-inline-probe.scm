;; Fixed node-0 cases.  No request evaluator, file export or link activation.
(define v020-failed #f)
(define (v020-log key value)
  (display "V020 ") (write key) (display " ")
  (org-texmacs-write-elisp value (current-output-port))
  (newline) (force-output))
(define (v020-decode node)
  (if (string? node) (cork->utf8 node)
      (cons (car node) (map v020-decode (cdr node)))))
(define (v020-check buffer node)
  (catch #t
    (lambda ()
      (let* ((body (list 'document (list 'concat "Before " node " after")))
             (encoded (org-texmacs-encode-body body '()))
             (native (stree->tree encoded)))
        (buffer-set-body buffer native)
        (let* ((readback (tree->stree (buffer-get-body buffer)))
               (same (equal? encoded readback))
               (decoded (v020-decode readback))
               (literal (equal? body decoded)))
          (v020-log 'case (list node same literal decoded))
          (if (not (and same literal)) (set! v020-failed #t)))))
    (lambda args
      (set! v020-failed #t)
      (v020-log 'case-error (list node args)))))
(catch #t
  (lambda ()
    (let ((buffer (buffer-new)))
      (for-each
        (lambda (node) (v020-check buffer node))
        '((em (concat "中文 " (strong "nested")))
          (underline "中文 <alpha>")
          (strike-through "中文 <alpha>")
          (verbatim "a  b\t<alpha> *literal* 中文")
          (next-line)
          (hlink (strong "label") "http://example.org/a")
          (hlink "label" "https://example.org/%20?q=a%26b&v=中文#part")
          (hlink "a@example.org" "mailto:a@example.org")
          (hlink "label" "ftp://example.org/a")
          (hlink "label" "ftps://example.org/a")
          (footnote (document (concat "中文 " (strong "bold"))))
          (concat (footnote (document "one"))
                  (footnote (document "two")))))
      (buffer-close buffer))
    (v020-log 'complete (not v020-failed)))
  (lambda args (v020-log 'fatal args)))
(quit-TeXmacs)
