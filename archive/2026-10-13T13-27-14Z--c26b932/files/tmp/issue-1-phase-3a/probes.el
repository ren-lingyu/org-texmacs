(defun p3-private-discovery ()
  "Research view only: clone global bibliography and mask authored STM.
Reject unsupported preprocessing through the existing private context adapter.
No AST filters, resolution, worker or arbitrary exporter is called here."
  (when (or (file-remote-p default-directory)
            (and buffer-file-name (file-remote-p buffer-file-name)))
    (error "Remote source context unsupported"))
  (when (and buffer-file-name
             (not (equal (file-name-as-directory (expand-file-name default-directory))
                         (file-name-directory (expand-file-name buffer-file-name)))))
    (error "Visiting directory/resource-base conflict needs a separate policy"))
  (let ((globals (mapcar #'copy-sequence org-cite-global-bibliography))
        (tags (org-texmacs--fragment-tags))
        (source (org-texmacs--source-buffer-text))
        (headings (org-texmacs--document-heading-settings))
        (links (org-texmacs--document-link-settings))
        (context (plist-put (org-texmacs--document-options) :texmacs-resource-base default-directory)))
    (org-texmacs--document-prepare-source source tags headings links context)
    (let ((org-export-allow-bind-keywords nil))
    (org-export-with-buffer-copy :drop-narrowing t
      (setq-local org-cite-global-bibliography (mapcar #'copy-sequence globals))
      (dolist (span (org-texmacs--fragment-collect tags))
        (let ((begin (org-texmacs-fragment-span-begin span))
              (end (org-texmacs-fragment-span-end span)))
          (goto-char begin)
          (delete-region begin end)
          (insert (org-texmacs--fragment-mask (org-texmacs-fragment-span-source span)))))
      (let ((blocks (org-element-map (org-element-parse-buffer) 'special-block
                      (lambda (node) (and (org-texmacs--block-p node) node)))))
        (dolist (block blocks)
          (let ((begin (org-element-property :contents-begin block))
                (end (org-element-property :contents-end block)))
            (when begin
              (let ((mask (org-texmacs--fragment-mask
                           (buffer-substring-no-properties begin end))))
                (goto-char begin) (delete-region begin end) (insert mask))))))
      (mapcar #'copy-sequence (org-cite-list-bibliography-files))))))

(ert-deftest p3-20-private-discovery-protects-stm-and-global-values ()
  (p3-source "#+bibliography: refs.bib\n(math \"x\")\n#+begin_texmacs\n#+bibliography: island.bib\n#+SETUPFILE: config/setup.org\n#+end_texmacs\n"
    (lambda ()
      (let* ((org-cite-global-bibliography (list "a.bib" "b.bib" "a.bib"))
             (globals (copy-tree org-cite-global-bibliography))
             (source (buffer-string))
             (calls 0)
             (spy (lambda (paths) (cl-incf calls) paths)))
        (unwind-protect
            (progn
              (advice-add 'org-cite-list-bibliography-files :filter-return spy)
              (cl-letf (((symbol-function 'org-file-contents)
                         (lambda (&rest _) (ert-fail "STM contents triggered read")))
                        ((symbol-function 'org-export-as)
                         (lambda (&rest _) (ert-fail "Unexpected exporter"))))
                (let ((paths (p3-private-discovery)))
                  (should (equal paths '("refs.bib" "a.bib" "b.bib")))
                  (should (= calls 1))
                  (should (equal source (buffer-string)))
                  (should (equal globals org-cite-global-bibliography))
                  (p3-record 'private-discovery
                             (list :paths paths :source-preserved t :config-preserved t :calls calls)))))
          (advice-remove 'org-cite-list-bibliography-files spy))))))

