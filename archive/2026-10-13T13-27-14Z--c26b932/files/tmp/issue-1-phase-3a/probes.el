(ert-deftest p3-22-full-discovery-view-masks-outside-body ()
  (p3-source "#+bibliography: refs.bib\nText\n#+begin_texmacs\n#+bibliography: island.bib\n#+end_texmacs\n"
    (lambda ()
      (search-forward "Text")
      (narrow-to-region (- (point) 4) (point))
      (let ((bounds (cons (point-min) (point-max))))
        (should (equal (p3-private-discovery) '("refs.bib")))
        (should (equal bounds (cons (point-min) (point-max))))
        (p3-record 'private-full-scope (list :paths '("refs.bib") :restriction-preserved t))))))

(ert-deftest p3-23-resource-conflict-and-bind-in-stm ()
  (p3-source "#+bibliography: refs.bib\n"
    (lambda ()
      (setq-local buffer-file-name (expand-file-name "visit/source.org" p3-root))
      (setq-local default-directory (file-name-as-directory (expand-file-name "base" p3-root)))
      (should-error (p3-private-discovery))
      (p3-record 'initial-resource-policy '(conflicting-visiting-directory-rejected))))
  (p3-source "#+bibliography: refs.bib\n#+begin_texmacs\n#+BIND: org-cite-global-bibliography (\"injected.bib\")\n#+SETUPFILE: config/setup.org\n#+end_texmacs\n"
    (lambda ()
      (let ((org-export-allow-bind-keywords t))
        (cl-letf (((symbol-function 'org-file-contents)
                   (lambda (&rest _) (ert-fail "BIND copy followed STM SETUPFILE"))))
          (should (equal (p3-private-discovery) '("refs.bib"))))
        (p3-record 'copy-bind-control '(disabled-before-copy))))))

(ert-deftest p3-24-preserves-explicit-extras-while-filling-missing ()
  (let* ((explicit '(("provided-only.bib" . "@book{provided-key}")))
         (result (p3-acquire '("refs.bib") p3-root explicit))
         (sources (plist-get result :sources)))
    (should (equal (mapcar #'car sources)
                   (list (expand-file-name "provided-only.bib" p3-root)
                         (expand-file-name "refs.bib" p3-root))))
    (should (equal (cdar sources) "@book{provided-key}"))
    (should (= (length (plist-get result :receipts)) 1))
    (p3-record 'merged-explicit (list :sources (mapcar #'car sources) :file-receipts 1))))

(ert-deftest p3-25-utf8-acquisition-boundary ()
  (let ((valid (expand-file-name "unicode.bib"))
        (invalid (expand-file-name "bad-encoding.bib")))
    (with-temp-file valid
      (let ((coding-system-for-write 'utf-8-unix))
        (insert "@book{unicode, title={中文 Café}}")))
    (should (equal (cdar (plist-get (p3-acquire (list valid) default-directory nil) :sources))
                   "@book{unicode, title={中文 Café}}"))
    (with-temp-file invalid
      (set-buffer-multibyte nil)
      (insert (concat "@book{bad, title={" (unibyte-string 255) "}}")))
    (should-error (p3-acquire (list invalid) default-directory nil))
    (p3-record 'utf8 (list :unicode-preserved t :invalid-encoding-rejected t))))

(with-temp-file "environment.txt"
  (insert (format "Emacs %s\nOrg %s\nNative TeXmacs operations: not run\n" emacs-version (org-version)))
  (dolist (library '(org ox oc))
    (insert (format "%s: %s\n" library (locate-library (symbol-name library))))))
(let ((stats (ert-run-tests-batch "^p3-")))
  (with-temp-file "observations.sexp"
    (let ((print-length nil) (print-level nil))
      (prin1 (nreverse p3-observations) (current-buffer)) (insert "\n")))
  (with-temp-file "summary.txt"
    (insert (format "Total: %s\nUnexpected: %s\n" (ert-stats-total stats)
                    (ert-stats-completed-unexpected stats))))
  (kill-emacs (if (zerop (ert-stats-completed-unexpected stats)) 0 1)))
