(defun p3-prepare (text sources)
  (p3-source text
    (lambda ()
      (let* ((calls 0)
            (org-cite-global-bibliography '("refs.bib"))
            (org-export-filter-parse-tree-functions
             (list (lambda (tree backend _info)
                     (cl-incf calls) (should (eq backend 'texmacs))
                     (org-element-map tree 'citation-reference
                       (lambda (r) (org-element-put-property r :key "external-key"))) tree))))
        (cl-letf (((symbol-function 'org-export-as)
                   (lambda (&rest _) (ert-fail "Unexpected generic exporter")))
                  ((symbol-function 'org-cite-process-citations)
                   (lambda (&rest _) (ert-fail "Unexpected processor")))
                  ((symbol-function 'org-texmacs--worker-request)
                   (lambda (&rest _) '(document (bib-entry "book" "external-key" (document)))))
                  ((symbol-function 'org-texmacs--bibliography-format)
                   (lambda (plan)
                     (list (plist-get plan :prefix) (plist-get plan :keys) (plist-get plan :entries)
                           (list 'bib-list "1"
                                 (list 'document
                                       (list 'concat (list 'label (concat (plist-get plan :prefix) "-external-key")) "Prepared")))))))
          (let ((input (org-texmacs-prepare-buffer (current-buffer) sources)))
            (should (= calls 1))
            (should (org-texmacs-document-p (org-texmacs-document input)))
            input))))))

