;;; probes.el --- Phase 3a research, not production -*- lexical-binding: t; -*-
(setq native-comp-jit-compilation nil)
(require 'ert)
(require 'cl-lib)
(require 'org)
(require 'ox)
(require 'oc)
(require 'org-texmacs)
(require 'ox-texmacs)
(defvar p3-observations nil)
(defvar p3-root (file-name-as-directory (expand-file-name "fixtures")))
(defun p3-record (name value) (push (cons name value) p3-observations))
(defun p3-source (text callback)
  (with-temp-buffer
    (let ((org-mode-hook nil) (org-inhibit-startup t)
          (org-cite-global-bibliography nil)
          (org-export-filter-parse-tree-functions nil)
          (org-export-before-processing-functions nil)
          (org-export-before-parsing-functions nil)
          (org-export-allow-bind-keywords nil))
      (org-mode) (setq-local default-directory p3-root)
      (insert text) (goto-char (point-min)) (funcall callback))))

;; Deliberately small, local acquisition model. No production API is introduced.
(defun p3-paths (paths base)
  (unless (and (proper-list-p paths) (stringp base) (file-name-absolute-p base))
    (error "Invalid discovery result or base"))
  (let (result)
    (dolist (path paths)
      (unless (and (stringp path) (> (length path) 0)
                   (not (cl-some (lambda (c) (memq c '(0 10 13)))
                                 (string-to-list path)))
                   (not (file-remote-p path)) (not (org-url-p path))
                   (not (string-prefix-p "~" path)))
        (error "Unsupported discovered identity"))
      (let* ((file-name-handler-alist nil) (id (expand-file-name path base)))
        (unless (member id result) (setq result (append result (list id))))))
    result))
(defun p3-attributes (path)
  (when (file-symlink-p path) (error "Symlink unsupported in initial model"))
  (let ((attributes (file-attributes path 'integer)))
    (unless (and attributes (null (file-attribute-type attributes))
                 (file-readable-p path) (<= (file-attribute-size attributes) 1048576))
      (error "Unreadable/non-regular/large dependency"))
    (list (file-attribute-size attributes)
          (file-attribute-modification-time attributes)
          (file-attribute-status-change-time attributes)
          (file-attribute-inode-number attributes)
          (file-attribute-device-number attributes))))
(defun p3-bytes (path)
  (with-temp-buffer
    (set-buffer-multibyte nil)
    (insert-file-contents-literally path)
    (buffer-string)))
(defun p3-acquire (paths base explicit)
  (let* ((ids (p3-paths paths base))
         (file-name-handler-alist nil)
         (provided (org-texmacs--bibliography-source-snapshot explicit base))
         receipts
         (result (mapcar (lambda (source)
                           (cons (copy-sequence (car source)) (copy-sequence (cdr source))))
                         provided))
         physical)
    (dolist (source provided)
      (org-texmacs--bibliography-validate-source (cdr source)))
    (dolist (id ids)
      (unless (assoc id provided)
        (let* ((before (p3-attributes id))
               (inode (nthcdr 3 before))
               (bytes (p3-bytes id))
               (after (p3-attributes id))
               (text (decode-coding-string bytes 'utf-8-unix)))
          (unless (and (not (cl-some (lambda (c) (> c #x10ffff)) (string-to-list text)))
                       (equal bytes (encode-coding-string text 'utf-8-unix)))
            (error "Invalid UTF-8 bibliography source"))
          (unless (equal before after) (error "Dependency changed while reading"))
          (when (member inode physical) (error "Physical file alias unsupported"))
          (push inode physical)
          (org-texmacs--bibliography-validate-source text)
          (push (list id before (secure-hash 'sha256 bytes)) receipts)
          (setq result (append result (list (cons (copy-sequence id) (copy-sequence text))))))))
    (list :sources result :receipts (nreverse receipts))))
(defun p3-check-receipts (receipts)
  (let ((file-name-handler-alist nil))
    (dolist (receipt receipts)
      (let* ((path (car receipt))
             (before (p3-attributes path))
             (digest (secure-hash 'sha256 (p3-bytes path)))
             (after (p3-attributes path)))
        (unless (and (equal before after) (equal before (nth 1 receipt))
                     (equal digest (nth 2 receipt)))
          (error "Dependency receipt invalidated"))))))

(ert-deftest p3-01-document-global-order-and-dedup ()
  (p3-source "#+bibliography: local.bib\n#+bibliography: local.bib\n#+bibliography: second.bib\n"
    (lambda ()
      (let ((org-cite-global-bibliography '("global.bib" "local.bib")))
        (let ((paths (org-cite-list-bibliography-files)))
          (should (equal paths '("local.bib" "second.bib" "global.bib")))
          (p3-record 'merge paths))))))

(ert-deftest p3-02-advice-order-and-owned-results ()
  (p3-source "#+bibliography: refs.bib\n"
    (lambda ()
      (let* ((calls 0)
             (managed (list (copy-sequence "managed.bib") (copy-sequence "refs.bib")))
             (spy (lambda (paths)
                    (cl-incf calls) (should (derived-mode-p 'org-mode))
                    (append managed paths))))
        (unwind-protect
            (progn
              (advice-add 'org-cite-list-bibliography-files :filter-return spy)
              (let* ((paths (org-cite-list-bibliography-files))
                     (owned (mapcar #'copy-sequence paths)))
                (should (= calls 1))
                (should (equal paths '("managed.bib" "refs.bib" "refs.bib")))
                (aset (car managed) 0 ?X)
                (should (equal owned '("managed.bib" "refs.bib" "refs.bib")))
                (p3-record 'advice (list :calls calls :owned owned
                                        :normalized (p3-paths owned p3-root)))))
          (advice-remove 'org-cite-list-bibliography-files spy))))))

(ert-deftest p3-03-visiting-file-vs-directory ()
  (p3-source "#+bibliography: refs.bib\n"
    (lambda ()
      (setq-local buffer-file-name (expand-file-name "visit/source.org" p3-root))
      (setq-local default-directory (file-name-as-directory (expand-file-name "base" p3-root)))
      (let* ((paths (org-cite-list-bibliography-files))
             (native (p3-paths paths default-directory))
             (explicit (org-texmacs--bibliography-source-snapshot
                        '(("refs.bib" . "@book{external-key}")) default-directory)))
        (should (equal paths '("../visit/refs.bib")))
        (should (equal native (list (expand-file-name "visit/refs.bib" p3-root))))
        (should (equal (caar explicit) (expand-file-name "base/refs.bib" p3-root)))
        (p3-record 'visiting-directory-mismatch
                   (list :paths paths :native native :existing-explicit (mapcar #'car explicit)))))))

