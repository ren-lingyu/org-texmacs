;;; probes.el --- Release investigation only -*- lexical-binding: t; -*-
(require 'json)
(defvar rr-output (getenv "PROBE_OUTPUT"))
(defvar rr-records nil)
(defun rr-write (name value)
  (let ((coding-system-for-write 'utf-8-unix) (print-circle t) (print-length nil) (print-level nil))
    (with-temp-file (expand-file-name name rr-output) (prin1 value (current-buffer)) (insert "\n"))))
(defun rr-text (name text)
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file (expand-file-name name rr-output) (insert text))))
(defun rr-case (name source &optional style initial)
  (condition-case err
      (with-temp-buffer
        (org-mode)
        (setq-local org-export-with-author nil)
        (let ((org-texmacs-document-style (or style '("generic")))
              (org-texmacs-document-initial initial))
          (insert "#+OPTIONS: toc:nil title:nil author:nil date:nil\n" source)
          (rr-text (concat name ".org") (buffer-string))
          (let* ((before (org-texmacs-test--document-buffer-state (current-buffer)))
                 (input (org-texmacs-prepare-buffer (current-buffer)))
                 (doc (org-texmacs-document input)))
            (rr-write (concat name "-ast.sexp") (org-texmacs-input-ast input))
            (rr-write (concat name "-tree.sexp") (org-texmacs-document-body doc))
            (rr-write (concat name "-paths.sexp") (org-texmacs-document-stm-paths doc))
            (rr-write (concat name "-islands.sexp") (org-texmacs-input-islands input))
            (org-texmacs-document-save doc (expand-file-name (concat name ".tm") rr-output))
            (org-texmacs-document-save-pdf doc (expand-file-name (concat name ".pdf") rr-output))
            (push (list name :ok t :islands (length (org-texmacs-input-islands input))
                        :source-preserved (equal before (org-texmacs-test--document-buffer-state (current-buffer)))) rr-records))))
    (error (push (list name :error (error-message-string err)) rr-records))))

(let ((coding-system-for-write 'utf-8-unix))
 (rr-write "environment.sexp" (list :emacs emacs-version :org (org-version) :texmacs org-texmacs-program
                                    :fontification (list org-src-fontify-natively org-fontify-whole-block-delimiter-line)))
 (org-texmacs-test--with-worker
  (dolist (case '(("fn-anon" . "Text[fn::A formula (math (frac \"1\" \"2\")) in a footnote].\n")
                  ("fn-inline-named" . "Text[fn:note:Another formula (math \"x\")]. Again[fn:note].\n")
                  ("fn-separate" . "Text[fn:note]. Again[fn:note].\n\n[fn:note] A formula (math (frac \"1\" \"2\")) in a footnote.\n")))
    (rr-case (car case) (cdr case)))
  (let* ((equation "(equation (concat \"0<longrightarrow>\" (math-up \"ker\") (around* \"(\" \"<alpha>\" \")\") \"<longrightarrow>\" (math-up \"ker\") (around* \"(\" \"<beta>\" \")\") \"<longrightarrow>\" (math-up \"ker\") (around* \"(\" \"<gamma>\" \")\") (above \"<longrightarrow>\" \"<delta>\") (math-up \"coker\") (around* \"(\" \"<alpha>\" \")\") \"<longrightarrow>\" (math-up \"coker\") (around* \"(\" \"<beta>\" \")\") \"<longrightarrow>\" (math-up \"coker\") (around* \"(\" \"<gamma>\" \")\") \"<longrightarrow>0\"))")
         (block (concat "#+begin_texmacs\n" equation "\n#+end_texmacs\n"))
         (initial '(("page-type" . "a4") ("page-odd" . "12.7mm") ("page-even" . "12.7mm")
                    ("page-right" . "12.7mm") ("page-top" . "12.7mm") ("page-bot" . "12.7mm"))))
    (rr-case "equation-combined" (concat block "\n" equation "\n") '("article") initial)
    (rr-case "equation-block" block '("article") initial)
    (rr-case "equation-inline" (concat equation "\n") '("article") initial)
    (rr-case "equation-mixed" (concat "Before " equation " after.\n") '("article") initial)
    (rr-case "equation-short" "#+begin_texmacs\n(equation \"x=1\")\n#+end_texmacs\n\n(equation \"x=1\")\n")
    (rr-case "math-mixed" "Before (math (frac \"1\" \"2\")) after.\n"))
  (rr-case "links" "[[https://example.org][ExternalLink]]\n\nSee [[*Target][InternalLink]].\n* Target\nTargetBody\n")
  (let ((native (org-texmacs--document-create
                 :body '(document (concat (hlink "ExternalLink" "https://example.org"))
                                  (concat (hlink "InternalLink" "#native-target"))
                                  (concat (label "native-target") "TargetBody")))))
    (org-texmacs-document-save native (expand-file-name "links-native.tm" rr-output))
    (org-texmacs-document-save-pdf native (expand-file-name "links-native.pdf" rr-output)))
  (rr-case "chinese" "中文正文 数学公式 (math \"x=1\") 中文尾部.\n\n* 中文标题\n*中文粗体* /中文斜体/ =中文等宽=\n")
  (let ((native (org-texmacs--document-create
                 :body '(document (concat "中文正文 数学公式 " (math "x=1") " 中文尾部. ")
                                  (section "中文标题")
                                  (concat (strong "中文粗体") " " (em "中文斜体") " " (verbatim "中文等宽") " ")))))
    (org-texmacs-document-save-pdf native (expand-file-name "chinese-native.pdf" rr-output))))
 ;; Batch font-lock describes actual text faces, not interactive incremental behavior.
 (dolist (case '(("plain" . "Before (math (frac \"1\" \"2\")) after.\n")
                 ("special" . "#+begin_texmacs\n(math (frac \"1\" \"2\"))\n#+end_texmacs\n")
                 ("src-stm" . "#+begin_src scheme\n(math (frac \"1\" \"2\"))\n#+end_src\n")))
   (with-temp-buffer
     (org-mode) (insert (cdr case))
     (let ((org-src-fontify-natively t))
       (font-lock-mode 1) (font-lock-ensure)
       (goto-char (point-min)) (search-forward "math")
       (let ((tag (get-text-property (1- (point)) 'face)))
         (search-forward "\"1\"")
         (push (list (concat "font-lock-" (car case)) :tag-face tag
                     :string-face (get-text-property (- (point) 2) 'face)) rr-records)))))
 (rr-write "results.sexp" (nreverse rr-records))
 (ert-run-tests-batch-and-exit
  '(or "^org-texmacs-document-block-" "^org-texmacs-pdf-block-quotation-and-center-layout$")))
