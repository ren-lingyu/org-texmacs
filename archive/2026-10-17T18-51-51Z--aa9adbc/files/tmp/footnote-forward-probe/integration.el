;;; integration.el --- Private PDF macro probe -*- lexical-binding: t; -*-
(require 'org-texmacs)
(require 'ox-texmacs)
(require 'json)
(setq org-texmacs-program (getenv "TEXMACS_PROGRAM"))
(let* ((out (getenv "PROBE_OUT"))
       (control (getenv "PROBE_CONTROL"))
       (default-directory (file-name-as-directory out))
       (org-export-with-toc nil) (org-export-with-title nil)
       (org-export-with-author nil) (org-export-with-date nil)
       (org-texmacs-export-discover-bibliography nil)
       (guard (org-texmacs-input-create
               (org-element-create 'org-data nil
                 (org-element-create 'paragraph nil "GuardSentinel.")) nil
               :initial '(("render-footnote*" . (macro "sym" "nr" "body" "GuardMacro")))))
       (session (org-texmacs-session-open)) owner original-session rows)
  (cl-labels
      ((mode (value) (with-temp-file control (insert value)))
       (check-guard ()
         (unless (and (eq owner org-texmacs--worker-process)
                      (equal original-session (org-texmacs--session-read session)))
           (error "Worker/session changed")))
       (export (style name source targets repeats &optional initial)
         (with-temp-buffer
           (org-mode) (insert source)
           (let* ((org-texmacs-document-style (list style))
                  (org-texmacs-document-initial initial)
                  (input (org-texmacs-prepare-buffer (current-buffer)))
                  (document (org-texmacs-document input))
                  (before (org-texmacs-document-serialize document))
                  (frozen (copy-tree (org-texmacs-document-body document))))
             (dotimes (repeat repeats)
               (let* ((file (expand-file-name (format "%s-%s-%d.pdf" style name repeat) out)))
                 (cond ((= repeat 1)
                        (org-texmacs-export-to-pdf-file (current-buffer) file))
                       ((and (= repeat 2) (equal name "minimal"))
                        (let ((buffer-file-name (concat (file-name-sans-extension file) ".org")))
                          (org-texmacs-export-to-pdf)))
                       (t (org-texmacs-document-save-pdf document file)))
                 (unless (equal source (buffer-string)) (error "Source changed"))
                 (unless (equal frozen (org-texmacs-document-body document)) (error "Input changed"))
                 (unless (equal before (org-texmacs-document-serialize document)) (error "Serialized input changed"))
                 (check-guard)
                 (push `((file . ,(file-name-nondirectory file)) (style . ,style) (name . ,name)
                         (targets . ,(vconcat targets)) (mode . ,(with-temp-buffer (insert-file-contents control) (buffer-string)))) rows)))))))
    (unwind-protect
        (progn
          (org-texmacs-session-set-document session (org-texmacs-document guard))
          (setq owner org-texmacs--worker-process original-session (org-texmacs--session-read session))
          (dolist (style '("generic" "article"))
            (mode "disabled")
            (export style "baseline" "MainA[fn::BodyA]\nMainB[fn::BodyB]\n" '("BodyA" "BodyB") 1)
            (export style "baseline-named" "MainA[fn:a] AgainA[fn:a].\n\n[fn:a] BodyA.\n" '("BodyA" "BodyA") 1)
            (mode "enabled")
            (export style "minimal" "MainA[fn::BodyA]\nMainB[fn::BodyB]\n" '("BodyA" "BodyB") 3)
            (export style "named-repeat" "MainA[fn:a] AgainA[fn:a].\n\n[fn:a] BodyA.\n" '("BodyA" "BodyA") 3)
            (export style "markup" "MainA[fn::BodyA *BoldA* and /ItalicA/].\n" '("BodyA") 3)
            (export style "cross-page" "MainA[fn::BodyA].\n\n#+begin_texmacs\n(new-page)\n#+end_texmacs\n\nMainB[fn::BodyB].\n" '("BodyA" "BodyB") 3)
            (export style "no-notes" "PlainSentinel.\n" nil 3)
            (export style "explicit-macro" "CustomSentinel.\n" nil 1
                    '(("render-footnote*" . (macro "sym" "nr" "body" "CustomBody"))))
            ;; Failure after mutation must clean private state and preserve shared peer.
            (mode "fail-after-override")
            (with-temp-buffer
              (org-mode) (insert "MainA[fn::BodyA].\n")
              (let ((org-texmacs-document-style (list style))
                    (file (expand-file-name (concat style "-must-not-exist.pdf") out)))
                (condition-case nil
                    (progn (org-texmacs-export-to-pdf-file (current-buffer) file)
                           (error "Injected rendering failure was ignored"))
                  (org-texmacs-rendering-error nil))
                (when (file-exists-p file) (error "Failed render published output"))))
            (check-guard)
            (mode "enabled")
            (export style "after-failure" "MainA[fn::BodyA]\nMainB[fn::BodyB]\n" '("BodyA" "BodyB") 3)
            (mode "disabled")
            (export style "after-disabled" "MainA[fn::BodyA]\nMainB[fn::BodyB]\n" '("BodyA" "BodyB") 1))
          (with-temp-file (expand-file-name "exports.json" out)
            (insert (json-encode (vconcat (nreverse rows)))))
          (message "INTEGRATION-EXPORT-OK %d" (length rows)))
      (org-texmacs-session-close session)
      (org-texmacs--worker-stop))))
