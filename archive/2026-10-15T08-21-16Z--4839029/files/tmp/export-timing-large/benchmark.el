;;; benchmark.el --- Isolated export timing -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'json)
(require 'subr-x)
(require 'org-texmacs)
(require 'ox-texmacs)
(require 'org-texmacs-preprocess)

(defvar bench-enabled nil)
(defvar bench-stack nil)
(defvar bench-metrics nil)
(defvar bench-operation 'other)
(defvar bench-composed nil)
(defvar bench-rows nil)
(defvar bench-advice nil)
(defvar bench-output (getenv "BENCH_OUTPUT"))
(defvar bench-factor (string-to-number (getenv "BENCH_FACTOR")))
(defvar bench-payload nil)
(defvar bench-meta nil)

(defun bench-timed (stage original args)
  (if (not bench-enabled)
      (apply original args)
    (let* ((parent (car bench-stack))
           (frame (vector stage (float-time) 0.0))
           (bench-stack (cons frame bench-stack)))
      (unwind-protect
          (apply original args)
        (let* ((elapsed (- (float-time) (aref frame 1)))
               (self (max 0.0 (- elapsed (aref frame 2))))
               (entry (or (gethash stage bench-metrics) (vector 0 0.0 0.0))))
          (when parent (aset parent 2 (+ (aref parent 2) elapsed)))
          (aset entry 0 (1+ (aref entry 0)))
          (aset entry 1 (+ (aref entry 1) elapsed))
          (aset entry 2 (+ (aref entry 2) self))
          (puthash stage entry bench-metrics))))))

(defun bench-add (symbol stage &optional kind)
  (let ((wrapper
         (lambda (original &rest args)
           (let ((bench-operation
                  (cond ((eq kind 'native) (cadr args))
                        ((eq kind 'parse) (if (cadr args) 'bibliography 'stm))
                        ((and (eq kind 'startup) (not (org-texmacs--worker-live-p))) 'startup)
                        (t bench-operation))))
             (let ((result (bench-timed
                            (if (eq kind 'wait) (format "wait_%s" bench-operation) stage)
                            original args)))
               (when (and bench-enabled (eq kind 'compose))
                 (setq bench-composed (plist-get result :source)))
               result)))))
    (advice-add symbol :around wrapper)
    (push (cons symbol wrapper) bench-advice)))

(defun bench-save ()
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file (expand-file-name "results.json" bench-output)
      (insert (json-serialize
               `((metadata . ,bench-meta) (runs . ,(vconcat (reverse bench-rows))))
               :null-object nil :false-object :json-false)))))

(defun bench-source-state ()
  (list (buffer-string) buffer-file-name default-directory (buffer-modified-p)
        (point) (mark t) mark-active (point-min) (point-max)
        (buffer-chars-modified-tick)))

(defun bench-large-run (source route format directory)
  ;; Start outside measurement: this matrix measures a live worker, not startup.
  (org-texmacs--worker-start)
  (with-current-buffer source
    (let* ((state (bench-source-state))
           (bench-metrics (make-hash-table :test #'equal))
           (bench-stack nil) (bench-composed nil)
           (explicit (equal route "explicit-source"))
           (expected-rejection (and (not explicit) (> (string-bytes bench-payload) 262144)))
           (file (expand-file-name (concat route "." format) directory))
           (command (if explicit
                        (if (equal format "pdf") #'org-texmacs-export-to-pdf-file
                          #'org-texmacs-export-to-texmacs-file)
                      (if (equal format "pdf") #'org-texmacs-export-to-pdf
                        #'org-texmacs-export-to-texmacs)))
           start elapsed target failure gc-count gc-time gc-count-delta gc-time-delta)
      (garbage-collect)
      (message "BENCH starting factor=%d route=%s format=%s bytes=%d"
               bench-factor route format (string-bytes bench-payload))
      (setq gc-count gcs-done gc-time gc-elapsed start (float-time))
      (let ((bench-enabled t))
        (condition-case err
            (setq target (if explicit (funcall command source file) (funcall command)))
          (error (setq failure (error-message-string err)))))
      (setq elapsed (- (float-time) start)
            gc-count-delta (- gcs-done gc-count)
            gc-time-delta (- gc-elapsed gc-time))
      ;; State and output validation are outside measured time, but must pass.
      (unless (equal state (bench-source-state)) (error "Source state changed"))
      (when (and (not explicit) (not failure))
        (unless (equal (string-trim bench-composed) (string-trim bench-payload))
          (error "Frontend changed expanded content")))
      (when target
        (with-temp-buffer
          (set-buffer-multibyte nil)
          (insert-file-contents-literally target nil 0 32)
          (unless (string-prefix-p (if (equal format "pdf") "%PDF-" "<TeXmacs|")
                                   (buffer-string))
            (error "Invalid native output header"))))
      (let ((stages (mapcar
                     (lambda (name)
                       (let ((entry (gethash name bench-metrics)))
                         `((stage . ,name) (calls . ,(aref entry 0))
                           (inclusive_s . ,(aref entry 1)) (exclusive_s . ,(aref entry 2)))))
                     (sort (hash-table-keys bench-metrics) #'string-lessp))))
        (push `((factor . ,bench-factor) (route . ,route) (format . ,format)
                (temperature . "warm") (repeat . 1)
                (source_bytes . ,(string-bytes bench-payload))
                (source_lines . ,(count-lines (point-min) (point-max)))
                (elapsed_s . ,elapsed) (gc_count . ,gc-count-delta) (gc_s . ,gc-time-delta)
                (output_bytes . ,(and target (file-attribute-size (file-attributes target))))
                (outcome . ,(cond ((not failure) "success")
                                 ((and expected-rejection
                                       (string-match-p "Source exceeds 256 KiB" failure))
                                  "expected-size-rejection")
                                 (t "conversion-error")))
                (error . ,failure) (source_state_preserved . t)
                (stages . ,(vconcat stages))) bench-rows))
      (bench-save)
      (message "BENCH finished factor=%d route=%s format=%s wall=%.6fs gc=%d/%.6fs result=%s"
               bench-factor route format elapsed gc-count-delta gc-time-delta
               (or failure "success")))))

(let* ((directory (make-temp-file "export-timing-large-" t))
       (original (with-temp-buffer
                   (insert-file-contents (expand-file-name "test.org" (getenv "BENCH_FIXTURES")))
                   (buffer-string)))
       (newline (string-match "\n" original))
       (title (substring original 0 (1+ newline)))
       (body (substring original (1+ newline)))
       source)
  (unless (and (member bench-factor '(10 40 160 640)) (string-prefix-p "#+TITLE:" title))
    (error "Unexpected factor or original fixture"))
  (setq bench-payload (concat title (apply #'concat (make-list bench-factor body))))
  (setq bench-meta
        `((emacs . ,emacs-version) (org . ,(org-version))
          (texmacs . ,(getenv "BENCH_TEXMACS_VERSION"))))
  (setq bench-meta
        (append bench-meta
                `((factor . ,bench-factor) (payload_bytes . ,(string-bytes bench-payload))
                  (payload_chars . ,(length bench-payload)) (repeats . 1)
                  (discovery . :json-false) (gc_cons_threshold . ,gc-cons-threshold)
                  (gc_cons_percentage . ,gc-cons-percentage)
                  (worker_request_timeout . ,org-texmacs-worker-request-timeout)
                  (measurement . "warm worker wall time; setup/startup/explicit GC excluded")
                  (limits . "default production limits unchanged; explicit-source bypasses preprocessing by API contract")
                  (stage_definition . "inclusive nested; exclusive subtracts measured children"))))
  (unwind-protect
      (progn
        (let ((coding-system-for-write 'utf-8-unix))
          (write-region bench-payload nil (expand-file-name "source.org" directory) nil 'silent))
        (setq source (find-file-noselect (expand-file-name "source.org" directory)))
        (with-current-buffer source
          (org-mode)
          (setq-local org-texmacs-export-discover-bibliography nil)
          (setq-local org-export-with-toc nil))
        (dolist (entry '((org-texmacs--source-buffer-text "source_capture")
                         (org-texmacs--preprocess-compose "preprocess" compose)
                         (org-texmacs--document-prepare-source "org_prepare")
                         (org-texmacs--document-lower "lowering")
                         (org-texmacs--worker-start "worker_start" startup)
                         (org-texmacs--worker-call "rpc_overhead")
                         (org-texmacs--worker-wait "wait" wait)
                         (org-texmacs--worker-request "parse_adapter" parse)
                         (org-texmacs--native-document-wire "native_wire")
                         (org-texmacs--native-call "native_adapter" native)
                         (org-texmacs--native-save-bytes "publication")))
          (apply #'bench-add entry))
        (dolist (route '("frontend" "explicit-source"))
          (dolist (format '("tm" "pdf"))
            (bench-large-run source route format directory))))
    (setq bench-enabled nil)
    (dolist (entry bench-advice) (advice-remove (car entry) (cdr entry)))
    (org-texmacs--worker-stop)
    (when (buffer-live-p source) (kill-buffer source))
    (delete-directory directory t)))
(message "BENCH complete: %d measured outcomes" (length bench-rows))

