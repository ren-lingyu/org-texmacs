org-texmacs-standard-cite-probe>   (or (gethash data (plist-get info :exported-data))
org-texmacs-standard-cite-probe>       ;; Handle broken links according to
org-texmacs-standard-cite-probe>       ;; `org-export-with-broken-links'.
org-texmacs-standard-cite-probe>       (cl-macrolet
org-texmacs-standard-cite-probe>          ((broken-link-handler
org-texmacs-standard-cite-probe>            (&rest body)
org-texmacs-standard-cite-probe>            `(condition-case err
org-texmacs-standard-cite-probe>                 (progn ,@body)
org-texmacs-standard-cite-probe>               (org-link-broken
org-texmacs-standard-cite-probe>                (pcase (plist-get info :with-broken-links)
org-texmacs-standard-cite-probe>                  (`nil (user-error "Org export aborted.  Unable to resolve link: %S\nSee `org-export-with-broken-links'" (nth 1 err)))
org-texmacs-standard-cite-probe>                  (`mark (org-export-data
