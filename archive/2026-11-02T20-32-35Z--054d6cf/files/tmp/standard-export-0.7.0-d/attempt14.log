org-texmacs-standard-cite-probe> (defun org-cite-basic-export-citation (citation style _ info)
org-texmacs-standard-cite-probe>   "Export CITATION object.
org-texmacs-standard-cite-probe> STYLE is the expected citation style, as a pair of strings or nil.  INFO is the
org-texmacs-standard-cite-probe> export communication channel, as a property list."
org-texmacs-standard-cite-probe>   (let ((has-variant-p
org-texmacs-standard-cite-probe>          (lambda (variant type)
org-texmacs-standard-cite-probe>            ;; Non-nil when style VARIANT has TYPE.  TYPE is either
org-texmacs-standard-cite-probe>            ;; `bare' or `caps'.
org-texmacs-standard-cite-probe>            (member variant
org-texmacs-standard-cite-probe>                    (pcase type
org-texmacs-standard-cite-probe>                      ('bare '("bare" "bare-caps" "b" "bc"))
org-texmacs-standard-cite-probe>                      ('caps '("caps" "bare-caps" "c" "bc"))
org-texmacs-standard-cite-probe>                      (_ (error "Invalid variant type: %S" type)))))))
org-texmacs-standard-cite-probe>     (pcase style
org-texmacs-standard-cite-probe>       ;; "author" style.
org-texmacs-standard-cite-probe>       (`(,(or "author" "a") . ,variant)
org-texmacs-standard-cite-probe>        (let ((caps (member variant '("caps" "c"))))
org-texmacs-standard-cite-probe>          (org-cite-basic--format-author-year
org-texmacs-standard-cite-probe>           citation
org-texmacs-standard-cite-probe>           (lambda (p c s) (org-cite-concat p c s))
org-texmacs-standard-cite-probe>           (lambda (prefix author _ suffix)
org-texmacs-standard-cite-probe>             (org-cite-concat
org-texmacs-standard-cite-probe>              prefix
org-texmacs-standard-cite-probe>              (if caps (org-cite-capitalize author) author)
org-texmacs-standard-cite-probe>              suffix))
org-texmacs-standard-cite-probe>           info)))
org-texmacs-standard-cite-probe>       ;; "noauthor" style.
org-texmacs-standard-cite-probe>       (`(,(or "noauthor" "na") . ,variant)
org-texmacs-standard-cite-probe>        (let ((bare? (funcall has-variant-p variant 'bare)))
org-texmacs-standard-cite-probe>          (org-cite-basic--format-author-year
org-texmacs-standard-cite-probe>           citation
org-texmacs-standard-cite-probe>           (lambda (prefix contents suffix)
org-texmacs-standard-cite-probe>             (org-cite-concat
org-texmacs-standard-cite-probe>              (unless bare? "(")
org-texmacs-standard-cite-probe>              prefix
org-texmacs-standard-cite-probe>              contents
org-texmacs-standard-cite-probe>              suffix
org-texmacs-standard-cite-probe>              (unless bare? ")")))
org-texmacs-standard-cite-probe>           (lambda (prefix _ year suffix)
org-texmacs-standard-cite-probe>             (org-cite-concat prefix year suffix))
org-texmacs-standard-cite-probe>           info)))
org-texmacs-standard-cite-probe>       ;; "nocite" style.
org-texmacs-standard-cite-probe>       (`(,(or "nocite" "n") . ,_) nil)
org-texmacs-standard-cite-probe>       ;; "text" and "note" styles.
org-texmacs-standard-cite-probe>       (`(,(and (or "text" "note" "t" "ft") style) . ,variant)
org-texmacs-standard-cite-probe>        (when (and (member style '("note" "ft"))
org-texmacs-standard-cite-probe>                   (not (org-cite-inside-footnote-p citation)))
org-texmacs-standard-cite-probe>          (org-cite-adjust-note citation info)
org-texmacs-standard-cite-probe>          (org-cite-wrap-citation citation info))
org-texmacs-standard-cite-probe>        (let ((bare (funcall has-variant-p variant 'bare))
org-texmacs-standard-cite-probe>              (caps (funcall has-variant-p variant 'caps)))
org-texmacs-standard-cite-probe>          (org-cite-basic--format-author-year
org-texmacs-standard-cite-probe>           citation
org-texmacs-standard-cite-probe>           (lambda (p c s) (org-cite-concat p c s))
org-texmacs-standard-cite-probe>           (lambda (p a y s)
org-texmacs-standard-cite-probe>             (org-cite-concat p
org-texmacs-standard-cite-probe>                              (if caps (org-cite-capitalize a) a)
org-texmacs-standard-cite-probe>                              (if bare " " " (")
org-texmacs-standard-cite-probe>                              y
org-texmacs-standard-cite-probe>                              (and (not bare) ")")
org-texmacs-standard-cite-probe>                              s))
org-texmacs-standard-cite-probe>           info)))
org-texmacs-standard-cite-probe>       ;; "numeric" style.
org-texmacs-standard-cite-probe>       ;;
org-texmacs-standard-cite-probe>       ;; When using this style on citations with multiple references,
org-texmacs-standard-cite-probe>       ;; use global affixes and ignore local ones.
org-texmacs-standard-cite-probe>       (`(,(or "numeric" "nb") . ,_)
org-texmacs-standard-cite-probe>        (pcase-let ((`(,prefix . ,suffix) (org-cite-main-affixes citation)))
org-texmacs-standard-cite-probe>          (org-export-data
org-texmacs-standard-cite-probe>           (org-cite-concat
org-texmacs-standard-cite-probe>            "(" prefix (org-cite-basic--citation-numbers citation info) suffix ")")
org-texmacs-standard-cite-probe>           info)))
org-texmacs-standard-cite-probe>       ;; Default ("nil") style.
org-texmacs-standard-cite-probe>       (`(,_ . ,variant)
org-texmacs-standard-cite-probe>        (let ((bare (funcall has-variant-p variant 'bare))
org-texmacs-standard-cite-probe>              (caps (funcall has-variant-p variant 'caps)))
org-texmacs-standard-cite-probe>          (org-cite-basic--format-author-year
org-texmacs-standard-cite-probe>           citation
org-texmacs-standard-cite-probe>           (lambda (p c s)
org-texmacs-standard-cite-probe>             (org-cite-concat (and (not bare) "(") p c s (and (not bare) ")")))
org-texmacs-standard-cite-probe>           (lambda (p a y s)
org-texmacs-standard-cite-probe>             (org-cite-concat p (if caps (org-cite-capitalize a) a) ", " y s))
org-texmacs-standard-cite-probe>           info)))
org-texmacs-standard-cite-probe>       ;; This should not happen.
org-texmacs-standard-cite-probe>       (_ (error "Invalid style: %S" style)))))
