org-texmacs-standard-cite-probe>                  (_ nil))))))
org-texmacs-standard-cite-probe>        (let* ((type (org-element-type data))
org-texmacs-standard-cite-probe>               (parent (org-element-parent data))
org-texmacs-standard-cite-probe>               (results
org-texmacs-standard-cite-probe>                (cond
org-texmacs-standard-cite-probe>                 ;; Ignored element/object.
org-texmacs-standard-cite-probe>                 ((memq data (plist-get info :ignore-list)) nil)
org-texmacs-standard-cite-probe>                  ;; Raw code.
org-texmacs-standard-cite-probe>                  ((eq type 'raw) (car (org-element-contents data)))
org-texmacs-standard-cite-probe>                 ;; Plain text.
org-texmacs-standard-cite-probe>                 ((eq type 'plain-text)
org-texmacs-standard-cite-probe>                  (org-export-filter-apply-functions
org-texmacs-standard-cite-probe>                   (plist-get info :filter-plain-text)
org-texmacs-standard-cite-probe>                   (let ((transcoder (org-export-transcoder data info)))
org-texmacs-standard-cite-probe>                     (if transcoder (funcall transcoder data info) data))
org-texmacs-standard-cite-probe>                   info))
org-texmacs-standard-cite-probe>                 ;; Secondary string.
org-texmacs-standard-cite-probe>                 ((not type)
org-texmacs-standard-cite-probe>                  (mapconcat (lambda (obj) (org-export-data obj info)) data ""))
org-texmacs-standard-cite-probe>                 ;; Element/Object without contents or, as a special
org-texmacs-standard-cite-probe>                 ;; case, headline with archive tag and archived trees
org-texmacs-standard-cite-probe>                 ;; restricted to title only.
org-texmacs-standard-cite-probe>                 ((or (not (org-element-contents data))
org-texmacs-standard-cite-probe>                      (and (eq type 'headline)
org-texmacs-standard-cite-probe>                           (eq (plist-get info :with-archived-trees) 'headline)
org-texmacs-standard-cite-probe>                           (org-element-property :archivedp data)))
org-texmacs-standard-cite-probe>                  (let ((transcoder (org-export-transcoder data info)))
org-texmacs-standard-cite-probe>                    (and (functionp transcoder)
org-texmacs-standard-cite-probe>                          (if (eq type 'link)
org-texmacs-standard-cite-probe>                             (broken-link-handler
org-texmacs-standard-cite-probe>                              (funcall transcoder data nil info))
org-texmacs-standard-cite-probe>                            (funcall transcoder data nil info)))))
org-texmacs-standard-cite-probe>                 ;; Element/Object with contents.
org-texmacs-standard-cite-probe>                 (t
org-texmacs-standard-cite-probe>                  (let ((transcoder (org-export-transcoder data info)))
org-texmacs-standard-cite-probe>                    (when transcoder
org-texmacs-standard-cite-probe>                      (let* ((greaterp (memq type org-element-greater-elements))
org-texmacs-standard-cite-probe>                             (objectp
org-texmacs-standard-cite-probe>                              (and (not greaterp)
org-texmacs-standard-cite-probe>                                   (memq type org-element-recursive-objects)))
org-texmacs-standard-cite-probe>                             (contents
org-texmacs-standard-cite-probe>                              (mapconcat
org-texmacs-standard-cite-probe>                               (lambda (element) (org-export-data element info))
org-texmacs-standard-cite-probe>                               (org-element-contents
org-texmacs-standard-cite-probe>                                (if (or greaterp objectp) data
org-texmacs-standard-cite-probe>                                  ;; Elements directly containing
org-texmacs-standard-cite-probe>                                  ;; objects must have their indentation
org-texmacs-standard-cite-probe>                                  ;; normalized first.
org-texmacs-standard-cite-probe>                                  (org-element-normalize-contents
org-texmacs-standard-cite-probe>                                   data
org-texmacs-standard-cite-probe>                                   ;; When normalizing first paragraph
org-texmacs-standard-cite-probe>                                   ;; of an item or
org-texmacs-standard-cite-probe>                                   ;; a footnote-definition, ignore
org-texmacs-standard-cite-probe>                                   ;; first line's indentation.
org-texmacs-standard-cite-probe>                                   (and
org-texmacs-standard-cite-probe>                                    (eq type 'paragraph)
org-texmacs-standard-cite-probe>                                    (org-element-type-p
org-texmacs-standard-cite-probe>                                      parent '(footnote-definition item))
org-texmacs-standard-cite-probe>                                    (eq (car (org-element-contents parent))
org-texmacs-standard-cite-probe>                                        data)
org-texmacs-standard-cite-probe>                                    (eq (org-element-property :pre-blank parent)
org-texmacs-standard-cite-probe>                                        0)))))
org-texmacs-standard-cite-probe>                               "")))
org-texmacs-standard-cite-probe>                        (broken-link-handler
org-texmacs-standard-cite-probe>                         (funcall transcoder data
org-texmacs-standard-cite-probe>                                  (if (not greaterp) contents
org-texmacs-standard-cite-probe>                                    (org-element-normalize-string contents))
org-texmacs-standard-cite-probe>                                  info)))))))))
org-texmacs-standard-cite-probe>          ;; Final result will be memoized before being returned.
org-texmacs-standard-cite-probe>          (puthash
