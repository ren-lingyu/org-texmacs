;;; organize.el --- Actual standard integration -*- lexical-binding: t; -*-
(require 'org-roam)
(require 'org-roam-organize)
(require 'ox-html)

(ert-deftest d-actual-organize-standard-transaction ()
  (org-texmacs-test--with-worker
   (let* ((root default-directory)
          (notes (expand-file-name "notes/" root))
          (org-roam-directory notes)
          (org-roam-organize-directory notes)
          (org-roam-db-location (expand-file-name "roam.db" root))
          (org-roam-db--connection (make-hash-table :test #'equal))
          (org-id-locations nil)
          (org-id-locations-file (expand-file-name "ids" root))
          (org-roam-db-update-on-save nil)
          (org-roam-organize-registry
           '((:name "navigation" :tag "map" :directory "navigation" :moc t :basic t)
             (:name "literature" :tag "ref" :directory "literature"
                    :cite t :bibliography t)))
          (uuid "55555555-5555-4555-8555-555555555555")
          (mode org-roam-organize-mode))
     (unwind-protect
         (progn
           (make-directory (expand-file-name "literature" notes) t)
           (make-directory (expand-file-name "navigation" notes) t)
           (with-temp-file (expand-file-name "literature/ref.org" notes)
             (insert (format ":PROPERTIES:\n:ID: %s\n:ROAM_REFS: @real-key\n:BIBLIOGRAPHY: refs.bib\n:END:\n#+TITLE: Reference\n#+FILETAGS: :ref:\n" uuid)))
           (with-temp-file (expand-file-name "literature/refs.bib" notes)
             (insert "@book{real-key, author={Doe, Jane}, title={Actual fixture reference}, year={2026}}\n"))
           (org-roam-db-sync)
           (org-roam-organize-mode 1)
           (should org-roam-organize-mode)
           (with-temp-buffer
             (org-mode)
             (setq default-directory notes
                   buffer-file-name (expand-file-name "root.org" notes))
             (insert (format "#+title: Actual Cite\n#+cite_export: texmacs plain\n[cite:@%s]\n#+print_bibliography:\n" uuid))
             (let* ((org-export-use-babel nil)
                    (before (buffer-string))
                    (document (org-texmacs--standard-consume 'document))
                    (printed (prin1-to-string document)))
               (message "ACTUAL ORGANIZE DOCUMENT %s" printed)
               (should (string-match-p "real-key" printed))
               (should (string-match-p "Actual fixture reference" printed))
               (should-not (string-match-p uuid printed))
               (should (equal before (buffer-string)))
               (let ((pdf (org-texmacs--standard-consume 'pdf)))
                 (should (string-prefix-p "%PDF-" pdf)))
               (let ((org-cite-export-processors '((t basic))))
                 (goto-char (point-min))
                 (search-forward "#+cite_export: texmacs plain")
                 (replace-match "#+cite_export: basic")
                 (should (string-match-p "Actual fixture reference" (org-export-as 'html)))))))
       (org-roam-organize-mode (if mode 1 -1))
       (org-roam-db--close-all)))))
