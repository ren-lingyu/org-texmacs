+;;; org-texmacs-cite.el --- Structured Org Cite processor -*- lexical-binding: t; package-lint-main-file: "org-texmacs.el"; -*-
+
+;; Copyright (C) 2026 aRenCoco
+;; SPDX-License-Identifier: GPL-3.0-or-later
+
+;;; Commentary:
+
+;; Org supplies final citation keys and bibliography sources.  Return native
+;; trees in Org wrappers; native bibliography work waits for owned input.
+
+;;; Code:
+
+(require 'oc)
+(require 'org-texmacs-bibliography)
+(defvar org-texmacs--standard-transaction)
+
+(defun org-texmacs--cite-fail (message)
+  "Reject unsupported citation semantics with MESSAGE."
+  (signal 'org-texmacs-document-error (list message)))
+
+(defun org-texmacs--cite-prefix (backend info)
+  "Return this export's native prefix from BACKEND and live INFO."
+  (unless (org-export-derived-backend-p backend 'texmacs)
+    (org-texmacs--cite-fail "The texmacs Cite processor requires the TeXmacs backend"))
+  (or (plist-get info :texmacs-cite-prefix)
+      (let ((prefix (concat "org-texmacs-cite-"
+                            (org-export-get-reference (plist-get info :parse-tree) info))))
+        (setf (plist-get info :texmacs-cite-prefix) prefix)
+        prefix)))
+
+(defun org-texmacs--cite-print-count (info)
+  "Count standard print directives in final INFO."
+  (length (org-element-map (plist-get info :parse-tree) 'keyword
+                          (lambda (node)
+                            (and (equal (org-element-property :key node) "PRINT_BIBLIOGRAPHY") node)))))
+
+(defun org-texmacs--cite-citation (citation style backend info)
+  "Return structured native output for CITATION/STYLE/BACKEND in INFO."
+  (unless (and (member (car style) '(nil "numeric" "nb")) (null (cdr style)))
+    (org-texmacs--cite-fail "Unsupported TeXmacs citation style or variant"))
+  (unless (= 1 (org-texmacs--cite-print-count info))
+    (org-texmacs--cite-fail "Native citations require exactly one print_bibliography directive"))
+  (let ((prefix (org-texmacs--cite-prefix backend info)) keys)
+    (dolist (reference (org-cite-get-references citation))
+      (dolist (property '(:prefix :suffix))
+        (unless (cl-every (lambda (part) (and (stringp part) (string-blank-p part)))
+                          (org-element-property property reference))
+          (org-texmacs--cite-fail "Local citation affixes are not supported")))
+      (push (org-element-property :key reference) keys))
+    (append (org-element-property :prefix citation)
+            (list (org-element-create 'export-snippet
+                                      (list :back-end "texmacs" :texmacs-tree
+                                            (list 'with-bib prefix (cons 'cite (nreverse keys))))))
+            (org-element-property :suffix citation))))
+
+(defun org-texmacs--cite-bibliography (keys files style props backend info)
+  "Return a native bibliography job for standard KEYS/FILES/STYLE/PROPS.
+BACKEND/INFO belong to the same standard Org export transaction."
+  (unless (and (member style '(nil "plain")) (null props))
+    (org-texmacs--cite-fail "Only the plain TeXmacs bibliography without print options is supported"))
+  (unless (= 1 (org-texmacs--cite-print-count info))
+    (org-texmacs--cite-fail "Native bibliography supports exactly one print directive"))
+  (let* ((prefix (org-texmacs--cite-prefix backend info))
+         (acquired (org-texmacs--bibliography-acquire files default-directory nil nil)))
+    (unless org-texmacs--standard-transaction
+      (org-texmacs--cite-fail "Expected a live standard export transaction"))
+    (setf (plist-get org-texmacs--standard-transaction :bibliography-receipts)
+          (append (plist-get org-texmacs--standard-transaction :bibliography-receipts)
+                  (plist-get acquired :receipts)))
+    (org-element-create
+     'special-block
+     (list :type "texmacs" :texmacs-bibliography
+           (list :keys keys :acquired acquired :prefix prefix)))))
+
+(defun org-texmacs--cite-render (job)
+  "Render owned native bibliography JOB after the input snapshot is frozen."
+  (let ((keys (plist-get job :keys)) (prefix (plist-get job :prefix)))
+    (if (null keys) '(document "")
+      (let* ((acquired (plist-get job :acquired))
+             (index (make-hash-table :test #'equal)) entries)
+        (dolist (source (plist-get acquired :sources))
+          (let ((tree (org-texmacs--worker-request (cdr source) 'bibliography)))
+            (dolist (entry (cdr tree))
+              (when (and (consp entry) (eq (car entry) 'bib-entry))
+                (push entry (gethash (nth 2 entry) index))))))
+        (dolist (key keys)
+          (let ((matches (gethash key index)))
+            (unless (= 1 (length matches))
+              (org-texmacs--cite-fail (format "Missing or ambiguous bibliography key: %s" key)))
+            (push (car matches) entries)))
+        (let ((body (nth 3 (org-texmacs--bibliography-format
+                           (list :keys keys :prefix prefix :entries (cons 'document (nreverse entries)))))))
+          (org-texmacs--bibliography-check-receipts (plist-get acquired :receipts))
+          (list 'with-bib prefix body))))))
+
+(org-cite-register-processor 'texmacs
+  :export-citation #'org-texmacs--cite-citation
+  :export-bibliography #'org-texmacs--cite-bibliography
+  :cite-styles '((("nil")) (("numeric" "nb"))))
+
+(provide 'org-texmacs-cite)
+;;; org-texmacs-cite.el ends here
