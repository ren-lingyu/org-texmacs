;;; probe.el --- Isolated STM reader experiment -*- lexical-binding: t; -*-

(require 'cl-lib)

(defun probe-read (source)
  ;; Validate spelling before Lisp reading can erase distinctions.
  (let ((i 0) (n (length source)))
    (cl-labels
        ((peek () (and (< i n) (aref source i)))
         (take () (prog1 (peek) (cl-incf i)))
         (white () (memq (peek) '(32 9 10 13)))
         (skip () (while (white) (take)))
         (fail () (error "Rejected STM spelling at %d" i))
         (tag-char (c) (and c (<= 33 c 126)
                            (not (memq c '(34 35 39 40 41 44 59 91 92 93 96 124)))))
         (tag ()
           (let ((start i))
             (while (or (tag-char (peek)) (eq (peek) 92))
               (when (eq (take) 92)
                 (let ((c (take)))
                   (unless (and c (<= 33 c 126)) (fail)))))
             (when (or (= start i) (equal (substring source start i) "."))
               (fail))))
         (leaf ()
           (take)
           (while (not (eq (peek) 34))
             (let ((c (take)))
               (unless (and c (>= c 32) (/= c 127)) (fail))
               (when (= c 92)
                 (let ((escape (take)))
                   (cond
                    ((memq escape '(34 92 110 114 116)))
                    ((and escape (<= 48 escape 55))
                     (dotimes (_ 2)
                       (let ((digit (take)))
                         (unless (and digit (<= 48 digit 55)) (fail)))))
                    (t (fail)))))))
           (take))
         (datum ()
           (cond
            ((eq (peek) 34) (leaf))
            ((eq (peek) 40)
             (take)
             (skip)
             (tag)
             (while (white)
               (skip)
               (unless (eq (peek) 41) (datum)))
             (unless (eq (take) 41) (fail)))
            (t (fail)))))
      (skip)
      (datum)
      (skip)
      (unless (= i n) (fail))))
  (let* ((read-circle nil)
         (read-symbol-shorthands nil)
         (tree (car (read-from-string (substring-no-properties source)))))
    (probe-copy tree)))

(defun probe-copy (node &optional ancestors)
  (cond
   ((stringp node) (substring-no-properties node))
   ((and (proper-list-p node) (consp node) (symbolp (car node)) (car node)
         (not (memq node ancestors)))
    (cons (car node)
          (mapcar (lambda (child) (probe-copy child (cons node ancestors)))
                  (cdr node))))
   (t (error "Invalid STM tree"))))

(defun probe-write (tree)
  (cl-labels
      ((emit (node)
         (if (stringp node)
             (concat "\""
                     (mapconcat
                      (lambda (c)
                        (cond ((memq c '(34 92)) (string 92 c))
                              ((< c 32) (format "\\%03o" c))
                              ((= c 127) "\\177")
                              (t (string c))))
                      node "")
                     "\"")
           (let* ((tag (car node))
                  (name (symbol-name tag)))
             (unless (and (let ((read-symbol-shorthands nil))
                            (eq (intern-soft name) tag))
                          (string-match-p "\\`[!-~]+\\'" name))
               (error "Unrepresentable tag: %s" name))
             (concat "("
                     (if (string-match-p "\\`[A-Za-z][A-Za-z0-9_-]*\\'" name)
                         name
                       (mapconcat (lambda (c) (string 92 c)) name ""))
                     (mapconcat (lambda (child) (concat " " (emit child))) (cdr node) "")
                     ")")))))
    (let ((text (emit (probe-copy tree))))
      (unless (equal tree (probe-read text)) (error "Changed tree"))
      text)))

(defun probe-result (operation value)
  (condition-case err
      (list 'ok (funcall operation value))
    (org-texmacs-worker-error (signal (car err) (cdr err)))
    (error (list 'reject (error-message-string err)))))

(defconst probe-trees
  (append
   '((empty . "") (atom . "原子") (empty-compound . (math))
     (nested . (math (frac "1" "2")))
     (unicode . (math "π 中 𝛑"))
     (escapes . (math "quote \" slash \\ tail"))
     (controls . (math "line\nreturn\rtab\tend\001\000\177"))
     (quote-label . (quote "x")) (shorthand . (stm-probe-short-tag "x")))
   (mapcar (lambda (name) (cons (intern name) (list (intern name) "x")))
           '("123" "#tag" ":tag" "a(b)" "a\\b" "." "a;b"))))

(defconst probe-invalid
  '( "(tag . (\"x\"))" "'(tag \"x\")" "`(tag \"x\")"
     "(tag #1=(nested \"x\") #1#)" "(tag #1=(nested #1#))"
     "(tag #(\"x\" 0 1 (face bold)))" "(tag [\"x\"])" "(tag 2)" "(tag ?a)"
     "(tag \"bad\\q\")" "(tag \"x\") (tag \"y\")" "(tag \"x\") ; tail"
     "(tag \"x\") junk" "(tag \"x\""))

(defun probe-pure ()
  (when (or (featurep 'org-texmacs-worker) (executable-find "texmacs"))
    (error "Unexpected TeXmacs in pure experiment"))
  (dolist (entry probe-trees)
    (let* ((tree (cdr entry))
           (candidate (probe-write tree))
           (print-length 1) (print-level 1)
           (read-symbol-shorthands '(("stm-probe-short-" . "expanded-"))))
      (unless (and (equal tree (probe-read candidate))
                   (equal candidate (probe-write (probe-read candidate))))
        (error "Roundtrip failed for %S" (car entry)))
      (let ((print-length nil) (print-level nil)
            (print-escape-newlines t) (print-escape-control-characters t)
            (print-quoted nil))
        (prin1 (list 'tree (car entry) 'candidate candidate
                     'printer (probe-result #'probe-read (prin1-to-string tree))))
        (terpri))))
  (dolist (text probe-invalid)
    (let ((result (probe-result #'probe-read text)))
      (unless (eq (car result) 'reject) (error "Accepted: %S" text))
      (prin1 (list 'invalid text result)) (terpri)))
  (let* ((leaf (propertize (copy-sequence "text") 'face 'bold))
         (branch (list 'leaf leaf))
         (tree (list 'root branch branch))
         (copied (probe-copy tree)))
    (unless (and (equal tree copied)
                 (not (eq (cadr copied) (caddr copied)))
                 (not (eq (cadadr copied) (car (cdr (caddr copied)))))
                 (get-text-property 0 'face leaf)
                 (not (text-properties-at 0 (cadadr copied))))
      (error "Ownership failure"))
    (unless (eq 'reject (car (probe-result #'probe-write (list (make-symbol "math") "x"))))
      (error "Uninterned label accepted"))
    (princ "Ownership and uninterned label checks passed\n")))

(defun probe-native ()
  (require 'org-texmacs)
  (require 'ox-texmacs)
  (require 'org-texmacs-serialize)
  (require 'org-texmacs-worker)
  (princ (format "%s; TeXmacs=%s\n" (org-version nil t) org-texmacs-program))
  (unwind-protect
      (progn
        (unless (equal (org-texmacs--worker-request "(math \"x\")") '(math "x"))
          (error "Native smoke probe failed"))
        (dolist (entry probe-trees)
          (let* ((tree (cdr entry))
                 (old (probe-result
                       (lambda (value) (org-texmacs--serialize-stm-source value nil))
                       tree))
                 (new (probe-write tree)))
            (prin1 (list 'case (car entry) 'tree tree 'old old
                         'old-native (when (eq (car old) 'ok)
                                       (probe-result #'org-texmacs--worker-request (cadr old)))
                         'old-candidate (when (eq (car old) 'ok)
                                          (probe-result #'probe-read (cadr old)))
                         'new new 'new-native (probe-result #'org-texmacs--worker-request new)))
            (terpri)))
        (let ((text "(math \"x\") ; trailing comment\n"))
          (prin1 (list 'trailing-comment
                       (probe-result #'org-texmacs--worker-request text)
                       (probe-result #'probe-read text))) (terpri)))
    (org-texmacs--worker-stop)))

(with-temp-file (getenv "STM_REPORT")
  (let ((standard-output (current-buffer))
        (print-escape-newlines t)
        (print-escape-control-characters t))
    (princ (format "Emacs %s\n" emacs-version))
    (if (equal (getenv "STM_NATIVE") "1") (probe-native) (probe-pure))))
