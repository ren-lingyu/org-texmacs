;;; handoff.el --- initial standard Org Cite carrier observation -*- lexical-binding: t; -*-
(defvar f-info nil)
(defvar f-returned nil)
(defvar f-carrier 'semantic)
(defun f-citation (citation style backend info)
 (setq f-info info)
 (let ((node (if (memq f-carrier '(semantic semantic-list)) (org-element-copy citation)
               (org-element-create 'bold nil "Mock native citation"))))
  (push (cons node (list :kind 'citation :keys (org-cite-get-references citation t) :style style)) f-returned)
  node))
(defun f-bibliography (keys files style props backend info)
 (setq f-info info)
 (let ((node (if (memq f-carrier '(semantic semantic-list)) (org-element-create 'keyword '(:key "PRINT_BIBLIOGRAPHY" :value ""))
               (org-element-create 'special-block '(:type "texmacs")))))
  (push (cons node (list :kind 'bibliography :keys keys :files files :style style :props props)) f-returned)
  (if (eq f-carrier 'semantic-list) (list node) node)))
(org-cite-register-processor 'texmacs-native :export-citation #'f-citation :export-bibliography #'f-bibliography :cite-styles '((("nil"))))
(ert-deftest native-cite-initial-carrier-observation ()
 (let (records)
  (f-source "oc" "oc-source.el")
  (dolist (f-carrier '(semantic semantic-list other))
   (with-temp-buffer
    (org-mode)
    (insert "#+bibliography: references.bib\n#+cite_export: texmacs-native plain\nFirst [cite:@one]. Again /[cite:@one]/. Multiple [cite:@one; @two].\n#+print_bibliography:\n")
    (let ((f-info nil) (f-returned nil) (org-export-use-babel nil)
          (bridge (symbol-function 'org-texmacs--standard-input)) caught final result)
     (condition-case err
      (cl-letf (((symbol-function 'org-texmacs--worker-request) (lambda (&rest _) (ert-fail "mock handoff cannot use worker")))
                ((symbol-function 'org-texmacs--standard-input)
                 (lambda (info state)
                  (setq final (plist-get info :parse-tree))
                  (let (links) (dolist (p f-returned)
                   (push (list :kind (plist-get (cdr p) :kind) :returned-present
                     (not (null (org-element-map final t (lambda (n) (and (eq n (car p)) t)) nil t)))) links))
                   (setq result links))
                  (funcall bridge info state))))
       (org-texmacs-prepare-buffer (current-buffer)))
      (error (setq caught (f-str err))))
     (push (list :carrier f-carrier :error caught :associations result :final (and final (f-str final))
                 :callback-count (length f-returned)) records))))
  (f-write "initial-handoff.json" (nreverse records))))
(load (getenv "NATIVE_ADAPTER") nil t)
(ert-deftest native-cite-mock-owned-handoff ()
 (x-with-processors
  (let* ((org-cite-export-processors '((t texmacs-native)))
         (header "#+bibliography: references.bib\n#+cite_export: texmacs-native plain\n")
         (body "First [cite:@one] followed.\n\nRepeat /[cite:@one]/. Multiple [cite:@one; @two].\n\n#+print_bibliography:\nAfter bibliography.\n") rows)
   (dolist (test '(base no-document-processor document-overrides copy-filter delete-filter replace-filter subtree visible default-other))
    (let* ((org-cite-export-processors (if (memq test '(document-overrides default-other)) '((t texmacs-other)) org-cite-export-processors))
           (org-export-filter-parse-tree-functions
            (pcase test
             ('copy-filter (list (lambda (tree _backend _info) (org-element-copy tree))))
             ('delete-filter (list (lambda (tree _backend _info)
                                    (org-element-map tree 'citation
                                     (lambda (n) (when (member "two" (org-cite-get-references n t)) (org-element-extract-element n)))) tree)))
             ('replace-filter (list (lambda (tree _backend _info)
                                     (org-element-map tree 'citation-reference (lambda (r) (org-element-put-property r :key "two"))) tree)))))
           (source (concat (unless (memq test '(no-document-processor default-other)) header)
                    (if (memq test '(subtree visible))
                        (concat "* Keep\n" body "\n* Hidden\nExcluded [cite:@missing].\n") body)))
           (result (x-run source nil (and (memq test '(subtree visible)) test))))
     (should (cl-every (lambda (r) (plist-get r :in-final)) (plist-get result :identity)))
     (when (eq test 'document-overrides) (should-not (string-match-p ":provider other" (plist-get result :requests))))
     (when (eq test 'default-other) (should (string-match-p ":provider other" (plist-get result :requests))))
     (when (eq test 'base)
      (should (< (string-match "First" (plist-get result :body)) (string-match "Mock one" (plist-get result :body))))
      (should (< (string-match "Mock one" (plist-get result :body)) (string-match "After bibliography" (plist-get result :body))))
      (should (string-match-p "followed" (plist-get result :body))))
     (when (eq test 'replace-filter) (should-not (string-match-p "Mock one" (plist-get result :body))))
     (push (list :case test :body (plist-get result :body) :requests (plist-get result :requests) :identity (plist-get result :identity)) rows)))
   (let ((x-orphan t))
    (push (list :case 'orphan-request :error (f-str (should-error (x-run (concat header body))))) rows))
   (let ((x-remap nil))
    (push (list :case 'missing-first-remap :error (f-str (should-error (x-run (concat header body))))) rows))
   (dolist (case '(unsupported-style missing-key failure quit))
    (let ((x-fail (pcase case ('failure t) ('quit 'quit))))
     (push (list :case case :error
       (f-str (if (eq case 'quit)
          (condition-case err (x-run (concat header body)) (quit err))
         (should-error (x-run (concat header
           (pcase case ('unsupported-style (concat "[cite/t:@one]\n" body)) ('missing-key (concat "[cite:@missing]\n" body)) (_ body)))))))) rows)))
   (let ((one (x-run (concat header body))) (two (x-run (concat header body))))
    (should (equal (plist-get one :body) (plist-get two :body)))
    (should-not (eq (org-texmacs-input-ast (plist-get one :input)) (org-texmacs-input-ast (plist-get two :input)))))
   (let* ((x-nest t) (x-nested-records nil)
          (outer (x-run (concat header "Outer [cite:@one].\n#+print_bibliography:\n"))))
    (should (= (length x-nested-records) 1))
    (should (string-match-p "Mock one" (plist-get outer :body)))
    (should-not (string-match-p "Mock two" (plist-get outer :body)))
    (should (string-match-p "Mock two" (plist-get (car x-nested-records) :body)))
    (should-not (string-match-p "Mock one" (plist-get (car x-nested-records) :body)))
    (push (list :case 'nested-isolation :outer (plist-get outer :body) :inner (plist-get (car x-nested-records) :body)) rows))
   (f-write "mock-handoff.json" (nreverse rows)))))
