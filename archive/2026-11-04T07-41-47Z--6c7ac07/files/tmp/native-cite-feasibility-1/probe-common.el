;;; probe-common.el --- isolated feasibility helpers -*- lexical-binding: t; -*-
(require 'oc)
(require 'json)
(defun f-out (name) (expand-file-name name (file-name-directory (getenv "ORG_TEXMACS_TEST_NAMES_FILE"))))
(defun f-str (x) (let ((print-length nil) (print-level nil) (print-circle t)) (prin1-to-string x)))
(defun f-json (x)
 (cond ((or (null x) (eq x t) (stringp x) (numberp x)) x)
       ((and (consp x) (keywordp (car x))) (let ((h (make-hash-table :test 'equal))) (while x (puthash (substring (symbol-name (pop x)) 1) (f-json (pop x)) h)) h))
       ((listp x) (vconcat (mapcar #'f-json x))) (t (format "%s" x))))
(defun f-write (name data) (with-temp-file (f-out name) (let ((json-encoding-pretty-print t)) (insert (json-encode (f-json data))))))
(defun f-render (doc name)
 (let ((pdf (f-out (concat name ".pdf"))))
  (org-texmacs-document-save doc (f-out (concat name ".tm")))
  (org-texmacs-document-save-pdf doc pdf)
  (call-process "pdftoppm" nil nil nil "-singlefile" "-f" "1" "-scale-to" "1500" "-png" pdf (f-out name))
  (org-texmacs-test--pdf-text pdf)))
(defun f-source (library filename)
 (require 'find-func)
 (with-temp-file (f-out filename) (insert-file-contents (find-library-name library))))
(defun f-launch (script result)
 (let ((run (make-temp-file "native-style-" nil ".scm")) process)
  (with-temp-file run (insert-file-contents script) (goto-char (point-max))
   (insert (format "\n(run-styles %s)\n(quit-TeXmacs)\n" (org-texmacs--scheme-string result))))
  (unwind-protect
   (with-temp-buffer
    (setq process (make-process :name "style-probe" :buffer (current-buffer) :connection-type 'pipe :coding 'utf-8-unix :noquery t :sentinel #'ignore
                   :command (list org-texmacs-program "-H" "-s" "-x" (format "(load %S)" run))))
    (let ((deadline (+ (float-time) 45))) (while (and (process-live-p process) (< (float-time) deadline)) (accept-process-output process 0.1)))
    (write-region (point-min) (point-max) (f-out "style-process-output.txt") nil 'silent)
    (should-not (process-live-p process)) (should (= 0 (process-exit-status process))))
   (when (and process (process-live-p process)) (delete-process process)))
  (with-temp-buffer (insert-file-contents result) (read (current-buffer)))))
