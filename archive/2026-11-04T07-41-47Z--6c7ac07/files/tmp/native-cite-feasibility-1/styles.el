;;; styles.el --- gate I, fixed native entries only -*- lexical-binding: t; -*-
(ert-deftest native-cite-style-mechanism ()
 (org-texmacs-test--with-worker
  (let* ((data (f-launch (getenv "NATIVE_STYLE_SCHEME") (f-out "styles.sexp")))
         (pairs (nth 3 data)) rows bodies)
   (f-source "oc" "oc-source.el")
   (dolist (pair pairs)
    (should (equal (car pair) (cadr pair)))
    (let ((record (car pair)))
     (should (equal (cadr (car (last record 2))) (cadr (car (last record)))))
     (push (list :result (f-str record) :repeat-equal t) rows)))
   (dolist (style '("plain" "alpha" "abbrv"))
    (let* ((result (cl-find-if (lambda (p) (equal style (nth 1 (car p)))) pairs))
           (body (nth 4 (car result)))
           (doc (org-texmacs--document-create
                 :body `(document
                         (with-bib "native-probe" (concat "Single " (cite "one") "; multiple " (cite "two" "one") "; repeated " (cite "one") "."))
                         (with-bib "native-probe" (concat "Detail " (cite-detail "one" "p. 7") "."))
                         (with-bib "native-probe" (nocite "three"))
                         (with-bib "native-probe" ,body))
                 :stm-paths '((0) (1) (2) (3)))))
     (should (eq (car body) 'bib-list))
     (push (list :style style :body (f-str body) :pdf-text (f-render doc (concat "style-" style))) bodies)))
   (let* ((pair (cl-find-if (lambda (p) (equal "alpha" (nth 1 (car p)))) pairs))
          (body (nth 4 (car pair)))
          (doc (org-texmacs--document-create :style '("generic" "cite-sort")
               :body `(document (with-bib "native-probe" (concat "Sorted " (cite "two" "one") "."))
                                (with-bib "native-probe" ,body)) :stm-paths '((0) (1)))))
    (push (list :style "alpha + document cite-sort" :body (f-str body)
                :pdf-text (f-render doc "style-alpha-cite-sort")) bodies))
   (should-not (equal (plist-get (car bodies) :body) (plist-get (cadr bodies) :body)))
   (f-write "styles.json" (list :catalog (car data) :bootstrap (f-str (nth 2 data)) :cases (nreverse rows) :rendered (nreverse bodies))))))
