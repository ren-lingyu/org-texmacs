;;; adapter.el --- project-side isolated request/ownership adapter -*- lexical-binding: t; -*-
(defconst x-core-input (symbol-function 'org-texmacs--standard-input))
(defconst x-core-copy (symbol-function 'org-texmacs--prepared-copy))
(defconst x-core-export (symbol-function 'org-export-as))
(defconst x-core-request (symbol-function 'org-texmacs--worker-request))
(defconst x-core-call (symbol-function 'org-texmacs--worker-call))
(defconst x-core-document (symbol-function 'org-texmacs-document))
(defvar x-mode 'mock)
(defvar x-provider 'native)
(defvar x-fail nil)
(defvar x-live-info nil)
(defvar x-observations nil)
(defvar x-remap t)
(defvar x-orphan nil)
(defvar x-nest nil)
(defvar x-nested-records nil)
(defun x-request (node request info)
 (plist-put info :x-requests (append (plist-get info :x-requests) (list (cons node request)))) node)
(defun x-citation (citation style _backend info)
 (unless (and (null (car style)) (null (cdr style))) (error "Unsupported native citation style: %S" style))
 (when x-nest
  (let ((x-nest nil) (org-export-filter-parse-tree-functions nil))
   (push (x-run "#+cite_export: texmacs-native plain\nInner [cite:@two].\n#+print_bibliography:\n") x-nested-records)))
 (let ((node (org-element-copy citation)))
  ;; No source coordinates are required for the carrier or its references.
  (org-element-map node t (lambda (n) (when (consp n) (org-element-put-property n :begin nil) (org-element-put-property n :end nil))) nil nil nil t)
  (x-request node (list :kind 'citation :keys (mapcar #'copy-sequence (org-cite-get-references citation t)) :provider x-provider) info)))
(defun x-bibliography (keys files style props _backend info)
 (when props (error "Unsupported native bibliography properties: %S" props))
 (let ((node (org-element-create 'keyword (list :key "PRINT_BIBLIOGRAPHY" :value ""))))
  (x-request node (list :kind 'bibliography :keys (mapcar #'copy-sequence keys)
                       :files (mapcar (lambda (f) (expand-file-name f)) files) :style (or style "plain") :provider x-provider) info)
  (when x-orphan
   (x-request (org-element-create 'keyword (list :key "PRINT_BIBLIOGRAPHY" :value ""))
              (list :kind 'bibliography :keys keys :files files :style style) info))
  (list node)))
(defmacro x-with-processors (&rest body)
 `(let ((org-cite--processors (copy-sequence org-cite--processors)))
   (org-cite-register-processor 'texmacs-native :export-citation #'x-citation :export-bibliography #'x-bibliography :cite-styles '((("nil"))))
   (org-cite-register-processor 'texmacs-other
     :export-citation (lambda (&rest args) (let ((x-provider 'other)) (apply #'x-citation args)))
     :export-bibliography (lambda (&rest args) (let ((x-provider 'other)) (apply #'x-bibliography args))) :cite-styles '((("nil"))))
   ,@body))
(defun x-mock-tree ()
 (list 'document
  (list 'bib-entry "book" "one" (list 'document (list 'bib-field "title" "One") (list 'bib-field "year" "2026")))
  (list 'bib-entry "book" "two" (list 'document (list 'bib-field "title" "Two") (list 'bib-field "year" "2025")))))
(defun x-mock-format (prefix keys _entries _style)
 (list 'bib-list (number-to-string (length keys))
  (cons 'document (cl-loop for key in keys for n from 1 collect
    (list 'concat (list 'bibitem* (number-to-string n)) (list 'label (concat prefix "-" key)) (concat "Mock " key))))))
(defun x-select-entries (sources keys)
 (cons 'document
  (mapcar (lambda (key)
    (let ((found (cl-mapcan (lambda (source)
       (cl-remove-if-not (lambda (entry) (and (consp entry) (eq (car entry) 'bib-entry) (equal (nth 2 entry) key))) (cdr (cdr source)))) sources)))
     (unless (= (length found) 1) (error "Missing or ambiguous native key: %s" key)) (car found))) keys)))
(defun x-real-fulfill (files keys style prefix)
 ;; Files/keys/style already belong to the owned request graph. Snapshot text once
 ;; before any native wait. This consumes standard Org Cite declarations, never
 ;; discovers bibliography independently or reads the Org source again.
 (let* ((texts (mapcar (lambda (file) (cons (copy-sequence file)
                    (with-temp-buffer (insert-file-contents file) (buffer-string)))) files))
        (script (make-temp-file "native-style-worker-" nil ".scm"))
        (worker-source (with-temp-buffer (insert-file-contents org-texmacs--worker-scheme-file) (buffer-string))))
  (unwind-protect
   (progn
    (with-temp-file script
     (insert (format "(define experiment-bib-style %s)\n" (org-texmacs--scheme-string style)))
     (insert worker-source)
     (goto-char (point-min))
     (should (search-forward "(module-provide '(bibtex plain))" nil t))
     (replace-match "(if (not (member (string-append \"tm-\" experiment-bib-style) (bib-standard-styles))) (error \"Unavailable native style\"))\n                       (module-provide (list 'bibtex (string->symbol experiment-bib-style)))" t t)
     (goto-char (point-min))
     (should (search-forward "(caddr request) \"plain\"" nil t))
     (replace-match "(caddr request) experiment-bib-style" t t))
    (org-texmacs--worker-stop)
    (let* ((org-texmacs--worker-scheme-file script)
           (sources (mapcar (lambda (pair) (cons (car pair) (org-texmacs--worker-request (cdr pair) 'bibliography))) texts))
           (entries (x-select-entries sources keys))
           (output (org-texmacs--bibliography-format (list :prefix prefix :keys keys :entries entries))))
     (list :sources sources :entries entries :body (nth 3 output))))
   (org-texmacs--worker-stop)
   (delete-file script))))
(defun x-finish (base)
 (let* ((info (org-texmacs-input-info base)) (registry (plist-get info :x-requests))
        (prints (cl-remove-if-not (lambda (p) (eq (plist-get (cdr p) :kind) 'bibliography)) registry)))
  (unless (= (length prints) 1) (error "Native requests require exactly one print"))
  (let* ((request (cdar prints)) (keys (plist-get request :keys)) (files (plist-get request :files))
         (style (plist-get request :style)) (prefix "native-cite")
         (native (and (eq x-mode 'real) (x-real-fulfill files keys style prefix)))
         (sources (if native (plist-get native :sources)
                    (list (cons (or (car files) "/mock/refs.bib") (x-mock-tree)))))
         (entries (if native (plist-get native :entries) (x-select-entries sources keys)))
         (body (if native (plist-get native :body) (x-mock-format prefix keys entries style))))
   (when x-fail (signal (if (eq x-fail 'quit) 'quit 'error) '("Injected mock transaction failure")))
   (setq info (plist-put (copy-sequence info) :x-native-prefix prefix))
   (setq info (plist-put info :texmacs-bibliography-declarations (mapcar (lambda (s) (cons (car s) (car s))) sources)))
   (setq info (plist-put info :texmacs-bibliography-output (list prefix keys entries body)))
   (let ((result (org-texmacs-input-create
                  (org-texmacs-input-ast base) info :islands (org-texmacs-input-islands base)
                  :style (org-texmacs-input-style base) :initial (org-texmacs-input-initial base)
                  :source-file (org-texmacs-input-source-file base) :resource-base (org-texmacs-input-resource-base base)
                  :bibliography sources)))
    (dolist (pair (plist-get (org-texmacs-input-info result) :x-requests))
     (should (org-element-map (org-texmacs-input-ast result) t (lambda (n) (eq n (car pair))) nil t)))
    (let ((before (f-str (org-texmacs-input-bibliography result))))
     (setcdr (cdar sources) nil)
     (should (equal before (f-str (org-texmacs-input-bibliography result)))))
    result))))
(defun x-run (text &optional options scope)
 (let* ((x-live-info nil) (x-observations nil) (processed 0) (filtered 0) (exports 0)
        (bridge x-core-input)
        (copy x-core-copy)
        (export x-core-export)
        (org-export-use-babel nil)
        (org-export-before-processing-functions (list (lambda (_) (cl-incf processed))))
        (org-export-filter-parse-tree-functions org-export-filter-parse-tree-functions)
        (org-texmacs--context-export-options (append org-texmacs--context-export-options '(:x-requests)))
        published text-result)
  (push (lambda (tree _backend _info) (cl-incf filtered) tree) org-export-filter-parse-tree-functions)
  (with-temp-buffer
   (org-mode) (insert "#+OPTIONS: toc:nil title:nil author:nil date:nil\n" text)
   (let ((source (buffer-string)))
    (when (eq scope 'subtree) (goto-char (point-min)) (re-search-forward "^\\* Keep") (beginning-of-line))
    (when (eq scope 'visible) (goto-char (point-min)) (re-search-forward "^\\* Hidden") (beginning-of-line) (org-fold-hide-subtree))
    (cl-letf (((symbol-function 'org-export-as) (lambda (&rest args) (cl-incf exports) (apply export args)))
              ((symbol-function 'org-texmacs--worker-request) (if (eq x-mode 'real) x-core-request (lambda (&rest _) (ert-fail "Mock request path must not call worker"))))
              ((symbol-function 'org-texmacs--worker-call) (if (eq x-mode 'real) x-core-call (lambda (&rest _) (ert-fail "Mock path must not call native protocol"))))
              ((symbol-function 'org-texmacs-document)
               (lambda (&rest args)
                (cl-letf (((symbol-function 'org-texmacs--worker-request) (lambda (&rest _) (ert-fail "Lowering cannot parse")))
                          ((symbol-function 'org-texmacs--worker-call) (lambda (&rest _) (ert-fail "Lowering cannot call worker"))))
                 (apply x-core-document args))))
              ((symbol-function 'org-texmacs--prepared-copy)
               (lambda (tree ignored identities)
                (let ((owned (funcall copy tree ignored identities)))
                 (when (and x-remap x-live-info (eq tree (plist-get x-live-info :parse-tree)))
                  (let (mapped)
                   (dolist (pair (plist-get x-live-info :x-requests))
                    (let ((node (gethash (car pair) identities)))
                     (unless node (error "Orphan native request during prepared copy"))
                     (should-not (eq node (car pair)))
                     (push (cons node (cdr pair)) mapped)))
                   (plist-put x-live-info :x-requests (nreverse mapped)))) owned)))
              ((symbol-function 'org-texmacs--standard-input)
               (lambda (info state)
                (let ((x-live-info info) (original-requests (plist-get info :x-requests)))
                 (setq x-observations (mapcar (lambda (p) (list :kind (plist-get (cdr p) :kind)
                    :post-blank (org-element-post-blank (car p))
                    :in-final (not (null (org-element-map (plist-get info :parse-tree) t (lambda (n) (eq n (car p))) nil t)))))
                    (plist-get info :x-requests)))
                 (let ((base (funcall bridge info state)))
                  (dolist (p (plist-get (org-texmacs-input-info base) :x-requests))
                   (should (org-element-map (org-texmacs-input-ast base) t (lambda (n) (eq n (car p))) nil t)))
                  (let* ((result (x-finish base))
                         (before (f-str (org-texmacs-input-info result))))
                   (when original-requests
                    (let ((keys (plist-get (cdar original-requests) :keys)))
                     (when keys (setcar keys "mutated-after-ownership")))
                    (org-element-put-property (caar original-requests) :style "mutated"))
                   (should (equal before (f-str (org-texmacs-input-info result))))
                   (setq published result)))))))
     (if (eq scope 'text)
         (progn (setq text-result (org-export-as 'texmacs nil nil nil options))
                (should (stringp text-result)))
       (setq published (org-texmacs--standard-consume 'input (eq scope 'subtree) (eq scope 'visible) options)))
     ;; Lowering after preparation runs under the same no-worker guard.
     (let* ((doc (cl-letf (((symbol-function 'org-texmacs--worker-request) (lambda (&rest _) (ert-fail "Pure lowering cannot parse")))
                            ((symbol-function 'org-texmacs--worker-call) (lambda (&rest _) (ert-fail "Pure lowering cannot call worker"))))
                  (org-texmacs-document published))) (body (org-texmacs-document-body doc)))
      (should (memq 'cite (flatten-tree body))) (should (memq 'bib-list (flatten-tree body)))
      (should (= exports 1)) (should (= processed 1)) (should (= filtered 1)) (should (equal source (buffer-string)))
      (when text-result
       (should (equal text-result (decode-coding-string (org-texmacs-document-serialize doc) 'iso-latin-1-unix))))
      (list :text text-result :body (f-str body) :requests (f-str (mapcar #'cdr (plist-get (org-texmacs-input-info published) :x-requests)))
            :identity x-observations :exports exports :preparation processed :filters filtered :document doc :input published)))))))
