(load "/home/lingyu/Projects/org-texmacs/lisp/org-texmacs-worker.scm")
(define (probe-flag thunk)
  (catch #t (lambda () (if (thunk) 1 0)) (lambda args -1)))
(define (probe-read source)
  (let* ((p (open-input-string source)) (x (read p)))
    (if (not (eof-object? (read p))) (error "multiple datum")) x))
(define (probe-source source input)
  (list (map char->integer (string->list source))
        (probe-flag (lambda () (equal? input (probe-read source))))
        (probe-flag (lambda () (equal? input (tree->stree (stm-snippet->texmacs source)))))
        (probe-flag (lambda () (equal? input (org-texmacs-parse source))))))
(define probe-original-reply org-texmacs-reply)
(set! org-texmacs-reply
  (lambda (request)
    (if (eq? (car request) 'probe-writers)
        (let ((id (cadr request)))
          (catch #t
            (lambda ()
              (let* ((input (org-texmacs-stm-wire-tree (caddr request)))
                     (scheme (call-with-output-string (lambda (p) (write input p))))
                     (native (catch #t (lambda () (texmacs->stm (stree->tree input))) (lambda args #f)))
                     (pure (cadddr request)))
                (list 'ok id (list (probe-source scheme input)
                                  (if native (probe-source native input) 'unavailable)
                                  (probe-source pure input)
                                  (probe-source (car (cddddr request)) input)))))
            (lambda args (list 'error id "probe generation failure"))))
        (probe-original-reply request))))
