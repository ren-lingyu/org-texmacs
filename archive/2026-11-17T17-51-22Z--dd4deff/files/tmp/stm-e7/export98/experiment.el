;;; experiment.el --- E6 real standard Export probes -*- lexical-binding: t; -*-
(load (expand-file-name "e4-adapter.el" (file-name-directory load-file-name)) nil t)
(require 'ox-texmacs)
(require 'ox-ascii)
(require 'ob-emacs-lisp)
(require 'org-id)
(load (expand-file-name "org-texmacs-document.el" probe-root) nil t)
(defvar e6-events nil)
(defvar e6-final nil)
(defvar e6-filter-action nil)
(defvar e6-nest nil)
(defvar e6-scope nil)
(defvar e6-original-backends org-export-registered-backends)
(defun e6-export-around (old backend &rest args)
  (if (org-export-derived-backend-p backend 'texmacs)
      (e3-scope t
                (lambda ()
                  (let* ((e6-scope t)
                         (base (org-export-get-backend 'texmacs))
                         (copy (copy-sequence base))
                         (org-export-registered-backends
                          (cons copy (delq base (copy-sequence org-export-registered-backends)))))
                    (setf (org-export-backend-transcoders copy)
                          (cons '(stm-fragment . org-texmacs--standard-contents)
                                (org-export-backend-transcoders base)))
                    (apply old backend args))))
    (let ((e3-active nil) (e6-scope nil)
          (org-element-all-objects e3-base-objects)
          (org-element-object-restrictions e3-base-restrictions)
          (org-export-registered-backends e6-original-backends))
      (apply old backend args))))
(defun e6-discover (old tree tags &optional defer)
  (if (not e6-scope) (funcall old tree tags defer)
    (let (requests)
      (cl-labels
          ((sequence (items parent)
             (cl-mapcan (lambda (n)
                          (let ((new (walk n parent)))
                            (if (eq (org-element-type n) 'stm-fragment)
                                (let ((post (or (org-element-property :post-blank n) 0)))
                                  (if (> post 0)
                                      (let ((blank (make-string post ?\s)))
                                        (org-element-put-property blank :parent parent)
                                        (list new blank))
                                    (list new)))
                              (list new)))) items))
           (walk (n parent)
             (cond
              ((eq (org-element-type n) 'stm-fragment)
               (let ((anchor (e4-anchor 0)))
                 (org-element-put-property anchor :parent parent)
                 (push (list anchor (org-element-property :stm-source n) nil) requests)
                 anchor))
              ((consp n)
               (unless (and defer (or (eq (org-element-type n) 'footnote-definition)
                                     (org-element-property :footnote-section-p n)))
                 (apply #'org-element-set-contents n (sequence (org-element-contents n) n))
                 (dolist (k (org-element-property :secondary n))
                   (unless (eq k :caption)
                     (org-element-put-property n k (sequence (org-element-property k n) n))))
                 (org-element-put-property n :caption
                                           (mapcar (lambda (pair) (cons (sequence (car pair) n)
                                                                       (sequence (cdr pair) n)))
                                                   (org-element-property :caption n)))) n)
              (t n))))
        (walk tree nil))
      (append (funcall old tree tags defer) (nreverse requests)))))
(defun e6-capture (old info state)
  (push 'standard-input e6-events)
  (push (e3-payloads (plist-get info :parse-tree)) e6-final)
  (funcall old info state))
(defun e6-filter (tree backend _info)
  (when (org-export-derived-backend-p backend 'texmacs)
    (push 'parse-tree-filter e6-events)
    (when e6-nest
      (let ((e6-nest nil) (org-export-filter-parse-tree-functions nil))
        (with-temp-buffer (org-mode) (insert "Nested $(math \"inner\")$\n")
          (push (list 'nested-ascii (org-export-as 'ascii nil nil t)) e6-events))))
    (pcase e6-filter-action
      ('modify (dolist (n (e3-fragments tree)) (org-element-put-property n :stm-source "(math \"modified\")")))
      ('delete (dolist (n (e3-fragments tree)) (org-element-extract-element n)))
      ('delete-parent (let ((p (car (org-element-map tree 'paragraph #'identity)))) (when p (org-element-extract-element p))))
      ('add (let ((p (car (org-element-map tree 'paragraph #'identity))))
              (when p (org-element-adopt p (org-element-create 'stm-fragment '(:stm-source "(math \"added\")" :post-blank 0))))))
      ('replace-parent (let ((p (car (org-element-map tree 'paragraph #'identity))))
                         (when p (org-element-set-contents p)
                               (org-element-adopt p "Replacement "
                                                  (org-element-create 'stm-fragment '(:stm-source "(math \"replaced\")" :post-blank 0))))))
      ('invalid (dolist (n (e3-fragments tree)) (org-element-put-property n :stm-source "(math #bad)")))
      ('error (error "intentional E6 filter error"))))
  tree)
(defun e6-options (info backend)
  (when (org-export-derived-backend-p backend 'texmacs)
    (push 'options-filter e6-events)
    (setq info (plist-put info :with-sub-superscript nil))) info)
(defun e6-one (name source &optional action subtree visible nested)
  (let ((e6-events nil) (e6-final nil) (e6-filter-action action) (e6-nest nested)
        (org-export-filter-parse-tree-functions '(e6-filter))
        (org-export-filter-options-functions '(e6-options))
        (org-export-use-babel t) (org-confirm-babel-evaluate nil)
        (org-export-with-broken-links t)
        (org-texmacs-typed-references t)
        (org-texmacs-document-style '("generic" "smart-ref")))
    (with-temp-buffer
      (org-mode) (setq default-directory (expand-file-name "fixtures/" probe-root))
      (insert "#+options: toc:nil title:nil author:nil date:nil\n" source)
      (goto-char (point-min))
      (when subtree (re-search-forward "^\\* Selected") (beginning-of-line))
      (when visible
        (save-excursion (goto-char (point-min)) (search-forward "* Hidden")
                        (beginning-of-line) (org-fold-hide-subtree)))
      (let ((before (buffer-string)))
        (condition-case e
            (let ((out (org-export-as 'texmacs subtree visible nil)))
              (list :name name :output out :events (format "%S" (reverse e6-events))
                    :final-payloads (nreverse e6-final) :source-unchanged (equal before (buffer-string))))
          (error (list :name name :error (error-message-string e)
                       :events (format "%S" (reverse e6-events)) :final-payloads (nreverse e6-final))))))))
(let (rows directory)
  (advice-add 'org-export-as :around #'e6-export-around)
  (advice-add 'org-texmacs--prepared-discover :around #'e6-discover)
  (advice-add 'org-texmacs--standard-input :around #'e6-capture)
  (unwind-protect
      (progn
        (org-texmacs--worker-start) (setq directory org-texmacs--worker-directory)
        (dolist (case '((basic "Before $(math \"x\")$ after.\n")
                        (modified "Before $(math \"original\")$ after.\n" modify)
                        (deleted "Before $(math \"deleted\")$ after.\n" delete)
                        (parent-deleted "Before $(math \"gone\")$.\n\nRemaining.\n" delete-parent)
                        (added "Before plain.\n" add)
                        (parent-replaced "$(math \"old parent\")$\n" replace-parent)
                        (invalid-filter "$(math \"valid before filter\")$\n" invalid)
                        (after-invalid "$(math \"valid after invalid\")$\n")
                        (options "x_i and $(math \"x\")$\n")
                        (include "#+include: included.org\n")
                        (setup "#+setupfile: setup.org\n{{{test}}}\n")
                        (macro "#+macro: test $(math \"macro\")$\n{{{test}}}\n")
                        (babel "#+begin_src emacs-lisp :exports results :results raw\n\"$(math \\\"babel\\\")$\"\n#+end_src\n")
                        (subtree "* Other\n$(math \"omit\")$\n* Selected\n$(math \"selected\")$\n" nil t)
                        (visible "* Visible\nVisible $(math \"visible\")$\n* Hidden\nHIDDEN $(math \"hidden\")$\n" nil nil t)
                        (nested "Outer $(math \"outer\")$\n" nil nil nil t)
                        (intentional-error "$(math \"x\")$\n" error)
                        (after-error "$(math \"recovered\")$\n")
                        (blocks "Inline $(math \"x\")$.\n\n#+name: eqn\n#+begin_equation\n\"x=1\"\n#+end_equation\n\n[[eqn]]\n\n#+begin_texmacs\n(concat \"native block\")\n#+end_texmacs\n")
                        (wrappers "Inline $(math \"x\")$.\n\n#+name: theorem\n#+begin_statement theorem\nStatement $(math \"s\")$.\n#+end_statement\n\n[[theorem]]\n\n#+name: fig\n#+caption: Figure $(math \"caption\")$\n#+begin_figure\n#+begin_texmacs\n(concat \"body\")\n#+end_texmacs\n#+end_figure\n\n[[fig]]\n\n#+name: tbl\n#+caption: Table\n#+begin_table\n| $(math \"cell\")$ |\n#+end_table\n\n[[tbl]]\n")
                        (cite "#+bibliography: refs.bib\nText [cite:@one, p. 2] and $(math \"x\")$.\n#+print_bibliography:\n")))
          (push (apply #'e6-one (symbol-name (car case)) (cdr case)) rows))
        (probe-write "results.json" (nreverse rows))
        (probe-write
         "nested-and-id.json"
         (list
          :ascii-containing-texmacs
          (let ((org-export-filter-parse-tree-functions
                 (list (lambda (tree backend _info)
                         (when (eq backend 'ascii)
                           (push (e6-one "inside-ascii" "$(math \"inside\")$\n") e6-events)) tree))))
            (with-temp-buffer (org-mode) (insert "Ordinary $(math \"ascii\")$\n")
              (let ((e6-events nil))
                (list :output (org-export-as 'ascii nil nil t) :nested e6-events))))
          :sequential-ascii
          (with-temp-buffer (org-mode) (insert "Ordinary $(math \"plain\")$\n") (org-export-as 'ascii nil nil t))
          :body-only-error
          (with-temp-buffer (org-mode) (insert "$(math \"x\")$\n")
                            (condition-case e (org-export-as 'texmacs nil nil t)
                              (error (error-message-string e))))
          :cross-file-id
          (let* ((file (expand-file-name "fixtures/target.org" probe-root))
                 (org-id-locations (org-id-alist-to-hash (list (cons file '("target-id")))))
                 (org-id-files (list file)) (org-id-extra-files nil) (org-agenda-files nil)
                 (org-id-locations-file (expand-file-name "fixtures/ids" probe-root))
                 (org-id--locations-checksum nil) (org-id-track-globally t))
            (e6-one "id" "External [[id:target-id][Target]] and $(math \"x\")$.\n")))))
    (advice-remove 'org-export-as #'e6-export-around)
    (advice-remove 'org-texmacs--prepared-discover #'e6-discover)
    (advice-remove 'org-texmacs--standard-input #'e6-capture)
    (org-texmacs--worker-stop))
  (probe-write "environment.json" (list :emacs emacs-version :org (org-version)
                                        :worker-live (org-texmacs--worker-live-p)
                                        :directory-removed (and directory (not (file-exists-p directory)))
                                        :registry-restored (equal org-element-all-objects e3-base-objects)
                                        :parser-restored (not (advice-member-p #'e3-parser 'org-element-latex-fragment-parser)))))
(princ "E6 matrix completed\n")
