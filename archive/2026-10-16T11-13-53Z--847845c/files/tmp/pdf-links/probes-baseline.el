;;; probes.el --- PDF link diagnostics -*- lexical-binding: t; -*-
(require 'json)
(defvar pl-output (getenv "PROBE_OUTPUT"))
(defun pl-write (name text)
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file (expand-file-name name pl-output) (insert text))))
(org-texmacs-test--with-worker
 (dolist (style '("generic" "article"))
  (with-temp-buffer
   (org-mode)
   (insert "#+OPTIONS: toc:nil title:nil author:nil date:nil\n[[https://example.org/pdf-link-test][ExternalLink]]\n\nSee [[*Target][InternalLink]].\n\n* Target\nTargetBody\n")
   (let* ((org-texmacs-document-style (list style))
          (before (org-texmacs-test--document-buffer-state (current-buffer)))
          (doc (org-texmacs-document-from-buffer (current-buffer)))
          (stem (concat "package-" style)))
    (org-texmacs-document-save doc (expand-file-name (concat stem ".tm") pl-output))
    (org-texmacs-document-save-pdf doc (expand-file-name (concat stem ".pdf") pl-output))
    (pl-write (concat stem "-tree.sexp") (prin1-to-string (org-texmacs-document-body doc)))
    (should (equal before (org-texmacs-test--document-buffer-state (current-buffer)))))))
(dolist (style '("generic" "article"))
 (dolist (preserve '("change" "preserve"))
  (dolist (method '("print-to-file" "export-postscript"))
   (let* ((name (format "native-%s-%s-%s" style preserve method))
          (pdf (expand-file-name (concat name ".pdf") pl-output))
          (script (expand-file-name (concat name ".scm") pl-output))
          (process-environment (copy-sequence process-environment)))
    (setenv "TEXMACS_HOME_PATH" (expand-file-name (concat name "-config") temporary-file-directory))
    (pl-write (concat name ".scm")
     (format "(use-modules (utils library cursor) (generic document-edit) (generic document-style))\n(begin (catch #t (lambda () (set-preference \"native pdf\" \"on\") (set-preference \"locus-on-paper\" %S) (let ((b (buffer-new))) (view-new b) (with-buffer b (set-style-list (list %S)) (buffer-set-body b (stree->tree '(document (concat (hlink \"ExternalLink\" \"https://example.org/pdf-link-test\")) (concat (hlink \"InternalLink\" \"#native-target\")) (concat (label \"native-target\") \"TargetBody\")))) (do ((pass 0 (+ pass 1))) ((= pass 3)) (update-current-buffer)) (%s (system->url %S)) (do ((pass 0 (+ pass 1))) ((= pass 3)) (update-current-buffer)) (%s (system->url %S)) (display \"PDF-LINK-OK\\n\")))) (lambda args (display \"PDF-LINK-ERROR\") (write args))) (quit-TeXmacs))\n" preserve style method pdf method pdf))
    (with-temp-buffer
     (let ((status (call-process "timeout" nil t nil "20s" org-texmacs-program "-H" "-s" "-x" (format "(load %S)" script))))
      (pl-write (concat name ".log") (buffer-string))
      (should (= status 0))
      (should (string-match-p "PDF-LINK-OK" (buffer-string)))
      (should (file-exists-p pdf))))))))
)
(dolist (style '("generic" "article"))
 (let ((directory (make-temp-file "pdf-link-reload-" t)))
  (unwind-protect
   (org-texmacs-test--issue11-reload-pdf
    (expand-file-name (concat "package-" style ".tm") pl-output)
    (expand-file-name (concat "reload-" style ".pdf") pl-output) directory)
   (delete-directory directory t))))
(pl-write "environment.sexp" (prin1-to-string (list :emacs emacs-version :org (org-version) :texmacs org-texmacs-program)))
