;;; performance.el --- Bounded presentation costs -*- lexical-binding: t; -*-
(require 'org-texmacs)
(require 'ert)
(defvar timings nil)
(dolist (size '(4096 16384 65536 262144 1048576))
  (dolist (enabled '(t nil))
    (with-temp-buffer
      (rename-buffer (generate-new-buffer-name "font-lock-performance"))
      (org-mode)
      (setq-local org-texmacs--font-lock-enabled enabled)
      (let ((unit "Text (math \"VALUE\") end.\n\n"))
        (insert (apply #'concat (make-list (ceiling size (length unit)) unit))))
      (let ((noninteractive nil)) (font-lock-mode 1))
      (let ((start (float-time)))
        (font-lock-ensure)
        (let ((initial (- (float-time) start)))
          (goto-char (/ (point-max) 2)) (search-forward "VALUE")
          (setq start (float-time))
          (insert "X")
          (let ((insertion (- (float-time) start)))
            (setq start (float-time))
            (font-lock-ensure (1- (point)) (point))
            (push (list :bytes (buffer-size) :enabled enabled :initial initial
                        :insertion insertion :refontify (- (float-time) start)) timings)))))))
(with-temp-file (expand-file-name "timings.sexp" (getenv "TIMING_OUTPUT"))
  (dolist (entry (nreverse timings)) (prin1 entry (current-buffer)) (insert "\n")))
