;;; probes.el --- Font-lock lifecycle investigation -*- lexical-binding: t; -*-
(require 'ert)
(require 'org)
(require 'org-src)
(load (getenv "FL_PROTOTYPE") nil t)
(defvar fl-results nil)
(defvar fl-output (getenv "PROBE_OUTPUT"))
(defun fl-record (name &rest values) (push (cons name values) fl-results))
(defmacro fl-with-source (source &rest body)
  (declare (indent 1))
  `(with-temp-buffer
     (rename-buffer (generate-new-buffer-name "fl-investigation"))
     (org-mode) (insert ,source) (buffer-enable-undo)
     (setq buffer-undo-list nil) (set-buffer-modified-p nil)
     ;; Controlled real hook registration, not actual GUI redisplay.
     (let ((noninteractive nil)) (font-lock-mode 1))
     (should font-lock-mode) (should jit-lock-mode)
     (should (memq 'jit-lock-after-change after-change-functions))
     (font-lock-ensure)
     ,@body))
(defun fl-position (word)
  (let ((case-fold-search nil))
    (save-excursion (goto-char (point-min)) (search-forward word) (1- (point)))))
(defun fl-owned (word) (get-text-property (fl-position word) 'fl-owned))
(defun fl-string-face (word)
  (let ((face (get-text-property (fl-position word) 'face)))
    (or (eq face 'font-lock-string-face)
        (memq 'font-lock-string-face (and (listp face) face)))))
(defun fl-state ()
  (list (buffer-substring-no-properties (point-min) (point-max))
        (buffer-modified-p) (buffer-chars-modified-tick) (point) (mark t)
        mark-active (point-min) (point-max) (copy-tree buffer-undo-list)))
(defun fl-properties (word)
  (let ((p (fl-position word)))
    (mapcar (lambda (prop) (list prop (let ((value (get-text-property p prop)))
                               (if (memq prop '(syntax-table keymap)) (and value t) value))))
            '(face syntax-table invisible display keymap mouse-face org-emphasis
                   org-linked-text font-lock-multiline fl-owned))))

(ert-deftest fl-native-helper-properties ()
  (fl-with-source "Before (math \"STRING\") after.\n"
    (let* ((span (org-texmacs-fragment-at-point (fl-position "STRING")))
           (before (fl-state)))
      (with-silent-modifications
        (org-src-font-lock-fontify-block "scheme"
                                       (org-texmacs-fragment-span-begin span)
                                       (org-texmacs-fragment-span-end span)))
      (should (equal before (fl-state)))
      (should (fl-string-face "STRING"))
      (should (get-text-property (fl-position "STRING") 'syntax-table))
      (fl-record 'direct-helper :properties (fl-properties "STRING")))))

(ert-deftest fl-basic-boundaries-and-ownership ()
  (fl-with-source "* Heading (math \"HEAD\")\n\n| (math \"TABLE\") |\n\n*em (math \"EMPH\")* and =(math \"CODE\")= and [[https://example.org][(math \"LINK\")]].\n\n#+begin_src scheme\n(math \"SRC\")\n#+end_src\n\nText (math \"PARA\") after.\n\n[fn::Note (math \"NOTE\")].\n\n#+BeGiN_TeXmAcS\n(math \"BLOCK\")\n#+eNd_TeXmAcS\n"
    (goto-char 9) (set-mark 4)
    (let ((before (fl-state)) (ordinary (fl-properties "HEAD")))
      (fl-enable)
      (fl-record 'boundary-diagnostic :spans fl-cache-spans :errors fl-soft-errors
                 :note (fl-properties "NOTE") :block (fl-properties "BLOCK"))
      (should (equal before (fl-state)))
      (dolist (word '("PARA" "NOTE" "BLOCK"))
        (should (fl-owned word)) (should (fl-string-face word))
        (should-not (get-text-property (fl-position word) 'syntax-table)))
      (dolist (word '("HEAD" "TABLE" "EMPH" "CODE" "LINK" "SRC"))
        (should-not (fl-owned word)))
      (should (equal ordinary (fl-properties "HEAD")))
      (fl-record 'boundaries :spans fl-cache-spans :scan-count fl-scan-count)
      (fl-disable)
      (should (equal before (fl-state)))
      (should-not (text-property-any (point-min) (point-max) 'fl-owned t)))))

(ert-deftest fl-default-and-local-tags ()
  (fl-with-source (concat (mapconcat (lambda (tag) (format "(%s \"value-%s\")" tag tag))
                                    org-texmacs-fragment-tags "\n\n")
                          "\n\n(custom \"CUSTOM\")\n")
    (fl-enable) (should (= 11 (length (fl-spans))))
    (should-not (fl-owned "CUSTOM"))
    (setq-local org-texmacs-fragment-tags '("custom"))
    (font-lock-ensure)
    (fl-record 'unflushed-config :old-colored (and (fl-owned "value-math") t)
               :new-colored (and (fl-string-face "CUSTOM") t))
    (fl-refresh) (should (= 1 (length (fl-spans))))
    (let ((colored (fl-string-face "CUSTOM")))
      (fl-record 'custom-diagnostic :spans fl-cache-spans :properties (fl-properties "CUSTOM"))
      (when (car fl-cache-spans) (fl-paint (caar fl-cache-spans) (cadar fl-cache-spans)))
      (fl-record 'custom-manual-color :colored (and (fl-string-face "CUSTOM") t))
      (should colored))
    (setq-local org-src-fontify-natively nil)
    (fl-refresh) (should-not (fl-owned "CUSTOM"))
    (fl-record 'configuration :explicit-refresh t)))

(ert-deftest fl-incremental-edit-observations ()
  (fl-with-source "Before (math \"ONE\") and (math \"TWO\") after.\n\nOutside *BOLD*.\n"
    (fl-enable)
    (let ((count fl-scan-count)) (font-lock-ensure) (should (= count fl-scan-count)))
    (goto-char (1+ (fl-position "ONE"))) (insert "X")
    (font-lock-ensure (1- (point)) (point))
    (should (fl-string-face "ONEX"))
    (goto-char (point-min)) (search-forward "ONEX\")") (delete-char -1)
    (font-lock-ensure (1- (point)) (point))
    (fl-record 'broken-paragraph :canonical-count (length (fl-spans))
               :first-stale (and (fl-owned "ONEX") t)
               :later-stale (and (fl-owned "TWO") t))
    (insert ")") (fl-refresh) (should (fl-string-face "TWO"))
    (fl-disable)
    (should-not (text-property-any (point-min) (point-max) 'fl-owned t))))

(ert-deftest fl-multiline-and-block-edit ()
  (fl-with-source "Start (math\n \"MULTI\") tail.\n\n#+begin_texmacs\n(unknown \"BLOCKTEXT\")\n#+end_texmacs\n\nEnd.\n"
    (fl-enable) (should (fl-string-face "MULTI")) (should (fl-string-face "BLOCKTEXT"))
    (goto-char (point-min)) (search-forward "#+end_texmacs")
    (let ((end (point))) (delete-region (- end (length "#+end_texmacs")) end))
    (font-lock-ensure (line-beginning-position) (line-end-position))
    (fl-record 'block-edit :canonical-count (length (fl-spans))
               :stale-block (and (fl-owned "BLOCKTEXT") t))
    (fl-refresh) (should-not (fl-owned "BLOCKTEXT"))
    (should (fl-string-face "MULTI"))))

(ert-deftest fl-malformed-note-soft-failure ()
  (fl-with-source "Good (math \"GOOD\").\n\n[fn::Broken (math \"BAD\"].\n"
    (fl-enable) (should fl-soft-errors)
    (fl-record 'malformed-note :errors (length fl-soft-errors)
               :unrelated-good-colored (and (fl-string-face "GOOD") t))
    (fl-disable)))

(ert-deftest fl-embedded-org-observations ()
  (fl-with-source "Outside *NORMAL*.\n\n(math \"*BOLD* [[https://example.org][INNERLINK]]\")\n"
    (setq-local org-hide-emphasis-markers t)
    (font-lock-flush) (font-lock-ensure)
    (let ((before (fl-properties "NORMAL")))
      (fl-enable) (should (equal before (fl-properties "NORMAL")))
      (should (fl-string-face "INNERLINK"))
      (fl-record 'embedded-org :link (fl-properties "INNERLINK")
                 :delimiter (fl-properties "[[") :bold (fl-properties "*BOLD")))))

(ert-deftest fl-narrowing-disable-major-mode ()
  (fl-with-source "(math \"OUTSIDE\")\n\n(math \"INSIDE\")\n"
    (fl-enable) (goto-char (point-min)) (search-forward "\n\n")
    (narrow-to-region (point) (point-max))
    (let ((bounds (cons (point-min) (point-max))))
      (fl-refresh) (should (= 1 (length (fl-spans)))) (fl-disable)
      (should (equal bounds (cons (point-min) (point-max))))
      (save-restriction (widen)
                        (should-not (text-property-any (point-min) (point-max) 'fl-owned t))))
    (widen) (fl-enable) (text-mode)
    (should-not (text-property-any (point-min) (point-max) 'fl-owned t))))

(ert-deftest fl-config-only-special-block-control ()
  (fl-with-source "#+begin_texmacs\n(math \"SPECIAL\")\n#+end_texmacs\n\n#+begin_src texmacs\n(math \"SOURCE\")\n#+end_src\n"
    (setq-local org-src-lang-modes (cons '("texmacs" . scheme) org-src-lang-modes))
    (font-lock-flush) (font-lock-ensure)
    (fl-record 'configuration-only :special-colored (and (fl-string-face "SPECIAL") t)
               :source-colored (and (fl-string-face "SOURCE") t))
    (should-not (fl-string-face "SPECIAL"))
    (should (fl-string-face "SOURCE"))))

(ert-deftest fl-quote-edit-boundary ()
  (fl-with-source "(math \"QUOTED\") after.\n\nOutside *STABLE*.\n"
    (fl-enable)
    (let ((outside (fl-properties "STABLE")))
      (goto-char (point-min)) (search-forward "\"") (delete-char -1)
      (font-lock-ensure (point) (1+ (point)))
      (fl-record 'quote-edit :remaining-colored (and (fl-owned "QUOTED") t))
      (should (equal outside (fl-properties "STABLE")))
      (insert "\"") (font-lock-ensure (1- (point)) (point))
      (should (fl-string-face "QUOTED")))))

(ert-deftest fl-buffer-isolation ()
  (fl-with-source "(math \"FIRST\")\n"
    (fl-enable)
    (let ((outer (current-buffer)) (count fl-scan-count))
      (fl-with-source "(custom \"SECOND\")\n"
        (setq-local org-texmacs-fragment-tags '("custom"))
        (fl-enable) (should (fl-string-face "SECOND")) (fl-disable))
      (should (eq outer (current-buffer))) (should (= count fl-scan-count))
      (should (fl-string-face "FIRST")))))

(ert-deftest fl-size-costs ()
  (let ((previous 0.0))
    (dolist (target '(4096 16384 65536 262144))
      (if (> previous 4.0)
          (fl-record 'cost-skipped :target target :reason 'preceding-scan-over-4s)
        (let ((text "") (n 0))
          (while (< (length text) target)
            (setq text (concat text (format "Prose (math \"unique-%d\") end.\n\n" n)) n (1+ n)))
          (fl-with-source text
            (let* ((t0 (float-time)) (spans (fl-spans))
                   (scan (- (float-time) t0)) (count fl-scan-count) (t1 (float-time)))
              (fl-spans)
              (let ((hit (- (float-time) t1)) (font-time nil) local-time local-spans)
                (save-excursion
                  (goto-char (/ (point-max) 2))
                  (beginning-of-line)
                  (when (looking-at-p "[ \t]*$") (forward-line 1))
                  (let ((b (line-beginning-position)) (e (line-end-position)))
                    (setq t1 (float-time))
                    (dotimes (_ 3)
                      (save-restriction
                        (narrow-to-region b e)
                        (setq local-spans
                              (org-texmacs-fragment-map
                               (point-min) (point-max)
                               (lambda (span)
                                 (list (org-texmacs-fragment-span-begin span)
                                       (org-texmacs-fragment-span-end span)))))))
                    (setq local-time (/ (- (float-time) t1) 3.0))
                    (should (= 1 (length local-spans)))
                    (should (equal (car local-spans)
                                   (cl-subseq (cl-find-if
                                               (lambda (span) (<= b (car span) (cadr span) e))
                                               spans) 0 2)))))
                (should (= count fl-scan-count))
                (when (and (<= target 65536) (< scan 2.0))
                  (setq t1 (float-time)) (fl-enable)
                  (setq font-time (- (float-time) t1)))
                (setq previous scan)
                (fl-record 'cost :bytes (length text) :fragments (length spans)
                           :scan-seconds scan :cached-seconds hit :fontify-seconds font-time
                           :bounded-paragraph-seconds local-time)))))))))

(let ((status 0))
  (cl-letf (((symbol-function 'make-process) (lambda (&rest _) (error "No subprocess permitted")))
            ((symbol-function 'start-process) (lambda (&rest _) (error "No subprocess permitted")))
            ((symbol-function 'call-process) (lambda (&rest _) (error "No subprocess permitted"))))
    (let ((stats (ert-run-tests-batch t)))
      (setq status (if (= 0 (ert-stats-completed-unexpected stats)) 0 1))))
  (with-temp-file (expand-file-name "results.sexp" fl-output)
    (insert "(\n")
    (dolist (entry (nreverse fl-results)) (prin1 entry (current-buffer)) (insert "\n"))
    (insert ")\n"))
  (kill-emacs status))
