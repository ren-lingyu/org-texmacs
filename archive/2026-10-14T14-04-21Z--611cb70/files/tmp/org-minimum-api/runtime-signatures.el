;;; runtime-signatures.el --- Actual tagged Org runtime audit -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'org)
(require 'org-element)
(require 'ox)
(require 'oc)
(require 'bytecomp)

(defun org-minimum-api-runtime-audit (project source baseline output)
  "Check actual Org 9.8 function signatures and strict project compilation."
  (unless (equal (org-version) "9.8") (error "Unexpected Org version %s" (org-version)))
  (unless (string-prefix-p (file-name-as-directory source) (locate-library "org"))
    (error "Org library escaped isolated source"))
  (let ((baseline-data (with-temp-buffer
                         (insert-file-contents baseline)
                         (read (current-buffer))))
        missing conflicts rows callbacks)
    (princ (format "RUNTIME Emacs %s Org %s path %s\n" emacs-version (org-version) (locate-library "org")))
    (dolist (row (plist-get baseline-data :rows))
      (let* ((name (car row))
             (signature (and (fboundp name) (help-function-arglist name t)))
             (arity (and (fboundp name) (not (macrop name)) (func-arity name)))
             (status (cond ((not (fboundp name)) (push name missing) 'missing)
                           ((and arity
                                 (cl-some (lambda (count)
                                            (or (< count (car arity))
                                                (and (numberp (cdr arity))
                                                     (> count (cdr arity))))) (nth 2 row)))
                            (push name conflicts) 'arity-conflict)
                           ((macrop name) 'macro-compile-check)
                           (t 'accepted))))
        (push (list name status signature arity (symbol-file name 'defun)) rows)))
    (dolist (row rows)
      (when (and (symbol-file (car row) 'defun)
                 (not (string-prefix-p (file-name-as-directory source)
                                       (symbol-file (car row) 'defun))))
        (error "Interface escaped Org 9.8 source: %S" (car row))))
    (dolist (entry (plist-get baseline-data :callback-signatures))
      (let* ((name (car entry))
             (exists (fboundp name))
             (signature (and exists (help-function-arglist name t))))
        (unless exists (cl-pushnew name missing))
        (when (and exists (symbol-file name 'defun)
                   (not (string-prefix-p (file-name-as-directory source) (symbol-file name 'defun))))
          (error "Callback escaped Org 9.8 source: %S" name))
        (push (list name (if exists 'present 'missing) signature :baseline (cadr entry)) callbacks)))
    (require 'ox-texmacs)
    (dolist (entry org-texmacs--capability-alist)
      (unless (org-texmacs--capability-present-p (car entry) (cdr entry))
        (cl-pushnew (car entry) missing)))
    (princ (format "CAPABILITIES %d declared function/variable checks completed\n"
                   (length org-texmacs--capability-alist)))
    (with-temp-file (expand-file-name "runtime-signatures.sexp" output)
      (let ((print-length nil) (print-level nil))
        (prin1 (list :version (org-version) :rows (nreverse rows)
                     :callbacks (nreverse callbacks) :missing missing :conflicts conflicts)
               (current-buffer))))
    (with-temp-buffer
      (insert-file-contents (expand-file-name "runtime-signatures.sexp" output))
      (princ (buffer-string)) (princ "\n"))
    (princ (format "SUMMARY runtime interfaces %d; callback references %d; missing %S; conflicts %S\n"
                   (length (plist-get baseline-data :rows))
                   (length (plist-get baseline-data :callback-signatures)) missing conflicts))
    ;; Compile only copied project files inside the builder's temporary directory.
    (let ((compile-dir (make-temp-file "project-compile-" t))
          (byte-compile-error-on-warn t)
          (byte-compile-warnings t))
      (dolist (file (directory-files project t "\\.el\\'"))
        (let ((copy (expand-file-name (file-name-nondirectory file) compile-dir)))
          (copy-file file copy)
          (unless (byte-compile-file copy) (error "Strict compilation failed: %s" file))))
      (princ "STRICT-COMPILE all 13 production modules passed against actual Org 9.8\n"))
    (when (or missing conflicts) (error "API/signature audit failed"))
    (princ "LIMIT: no complete ERT/native behavior validation of Org 9.8 performed.\n")))
