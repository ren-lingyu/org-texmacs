;;; benchmark.el --- Isolated export timing -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'json)
(require 'subr-x)
(require 'org-texmacs)
(require 'ox-texmacs)
(require 'org-texmacs-preprocess)

(defvar bench-enabled nil)
(defvar bench-stack nil)
(defvar bench-metrics nil)
(defvar bench-operation 'other)
(defvar bench-composed nil)
(defvar bench-rows nil)
(defvar bench-advice nil)
(defvar bench-output (getenv "BENCH_OUTPUT"))
(defvar bench-factor (string-to-number (getenv "BENCH_FACTOR")))
(defvar bench-payload nil)
(defvar bench-meta nil)

(defun bench-timed (stage original args)
  (if (not bench-enabled)
      (apply original args)
    (let* ((parent (car bench-stack))
           (frame (vector stage (float-time) 0.0))
           (bench-stack (cons frame bench-stack)))
      (unwind-protect
          (apply original args)
        (let* ((elapsed (- (float-time) (aref frame 1)))
               (self (max 0.0 (- elapsed (aref frame 2))))
               (entry (or (gethash stage bench-metrics) (vector 0 0.0 0.0))))
          (when parent (aset parent 2 (+ (aref parent 2) elapsed)))
          (aset entry 0 (1+ (aref entry 0)))
          (aset entry 1 (+ (aref entry 1) elapsed))
          (aset entry 2 (+ (aref entry 2) self))
          (puthash stage entry bench-metrics))))))

(defun bench-add (symbol stage &optional kind)
  (let ((wrapper
         (lambda (original &rest args)
           (let ((bench-operation
                  (cond ((eq kind 'native) (cadr args))
                        ((eq kind 'parse) (if (cadr args) 'bibliography 'stm))
                        ((and (eq kind 'startup) (not (org-texmacs--worker-live-p))) 'startup)
                        (t bench-operation))))
             (let ((result (bench-timed
                            (if (eq kind 'wait) (format "wait_%s" bench-operation) stage)
                            original args)))
               (when (and bench-enabled (eq kind 'compose))
                 (setq bench-composed (plist-get result :source)))
               result)))))
    (advice-add symbol :around wrapper)
    (push (cons symbol wrapper) bench-advice)))

(defun bench-save ()
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file (expand-file-name "results.json" bench-output)
      (insert (json-serialize
               `((metadata . ,bench-meta) (runs . ,(vconcat (reverse bench-rows))))
               :null-object nil :false-object :json-false)))))

(defun bench-run (source route format temperature repeat)
  ;; Exclude file visiting, explicit GC and deliberate worker shutdown from time.
  (when (equal temperature "cold") (org-texmacs--worker-stop))
  (unless (eq (not (null (org-texmacs--worker-live-p))) (equal temperature "warm"))
    (error "Unexpected worker state before %s" temperature))
  (with-current-buffer source
    (let* ((state (list (buffer-string) buffer-file-name default-directory
                        (buffer-modified-p) (point) (mark t) mark-active
                        (point-min) (point-max) (buffer-chars-modified-tick)))
           (bench-metrics (make-hash-table :test #'equal))
           (bench-stack nil) (bench-composed nil)
           (command (if (equal format "pdf") #'org-texmacs-export-to-pdf
                      #'org-texmacs-export-to-texmacs))
           start elapsed target failure gc-count gc-time)
      (garbage-collect)
      (setq gc-count gcs-done gc-time gc-elapsed start (float-time))
      (let ((bench-enabled t))
        (condition-case err
            (setq target (funcall command))
          (error (setq failure (error-message-string err)))))
      (setq elapsed (- (float-time) start))
      (let ((stages (mapcar
                     (lambda (name)
                       (let ((entry (gethash name bench-metrics)))
                         `((stage . ,name) (calls . ,(aref entry 0))
                           (inclusive_s . ,(aref entry 1)) (exclusive_s . ,(aref entry 2)))))
                     (sort (hash-table-keys bench-metrics) #'string-lessp))))
        (push `((factor . ,bench-factor) (route . ,route) (format . ,format)
                (temperature . ,temperature) (repeat . ,repeat)
                (elapsed_s . ,elapsed) (gc_count . ,(- gcs-done gc-count))
                (gc_s . ,(- gc-elapsed gc-time))
                (source_bytes . ,(string-bytes (buffer-string)))
                (expanded_bytes . ,(string-bytes bench-payload))
                (output_bytes . ,(and target (file-attribute-size (file-attributes target))))
                (error . ,failure) (stages . ,(vconcat stages))) bench-rows))
      (bench-save)
      (when failure (error "Benchmark conversion failed: %s" failure))
      (unless (equal (string-trim bench-composed) (string-trim bench-payload))
        (error "Expanded content differs from matched payload"))
      (unless (equal state (list (buffer-string) buffer-file-name default-directory
                                (buffer-modified-p) (point) (mark t) mark-active
                                (point-min) (point-max) (buffer-chars-modified-tick)))
        (error "Source state changed"))
      (with-temp-buffer
        (set-buffer-multibyte nil)
        (insert-file-contents-literally target nil 0 32)
        (unless (string-prefix-p (if (equal format "pdf") "%PDF-" "<TeXmacs|")
                                 (buffer-string))
          (error "Unexpected native output header")))
      (message "BENCH factor=%d route=%s format=%s temperature=%s repeat=%d wall=%.6fs gc=%d/%.6fs"
               bench-factor route format temperature repeat elapsed
               (- gcs-done gc-count) (- gc-elapsed gc-time)))))

(let* ((directory (make-temp-file "export-timing-" t))
       (fixtures (getenv "BENCH_FIXTURES"))
       (original (with-temp-buffer
                   (insert-file-contents (expand-file-name "test.org" fixtures))
                   (buffer-string)))
       (first-newline (string-match "\n" original))
       (title (substring original 0 (1+ first-newline)))
       (body (substring original (1+ first-newline)))
       sources)
  (unless (and (member bench-factor '(1 2 4 8)) (string-prefix-p "#+TITLE:" title))
    (error "Unexpected scale or original fixture header"))
  (setq bench-payload (concat title (apply #'concat (make-list bench-factor body))))
  (unless (< (string-bytes bench-payload) 65536) (error "INCLUDE input exceeds bound"))
  (setq bench-meta `((emacs . ,emacs-version) (org . ,(org-version))
                    (texmacs . ,(getenv "BENCH_TEXMACS_VERSION"))
                    (factor . ,bench-factor) (payload_bytes . ,(string-bytes bench-payload))
                    (payload_chars . ,(length bench-payload))
                    (gc_cons_threshold . ,gc-cons-threshold)
                    (gc_cons_percentage . ,gc-cons-percentage)
                    (discovery . :json-false) (repeats . 3)
                    (cold_definition . "new TeXmacs process; OS/font caches not flushed")
                    (measurement . "actual frontend wall time; visiting/explicit GC/worker stop excluded")
                    (stage_definition . "inclusive nested; exclusive subtracts measured children; do not sum inclusive")))
  (unwind-protect
      (progn
        (dolist (name '("direct.org" "test.org"))
          (let ((coding-system-for-write 'utf-8-unix))
            (write-region bench-payload nil (expand-file-name name directory) nil 'silent)))
        ;; Preserve the user's original INCLUDE expression exactly.
        (copy-file (expand-file-name "test_include.org" fixtures)
                   (expand-file-name "include.org" directory))
        (dolist (name '("direct" "include"))
          (let ((source (find-file-noselect (expand-file-name (concat name ".org") directory))))
            (with-current-buffer source
              (org-mode)
              (setq-local org-texmacs-export-discover-bibliography nil)
              (setq-local org-export-with-toc nil))
            (push (cons name source) sources)))
        (dolist (entry '((org-texmacs--source-buffer-text "source_capture")
                         (org-texmacs--preprocess-compose "preprocess" compose)
                         (org-texmacs--document-prepare-source "org_prepare")
                         (org-texmacs--document-lower "lowering")
                         (org-texmacs--worker-start "worker_start" startup)
                         (org-texmacs--worker-call "rpc_overhead")
                         (org-texmacs--worker-wait "wait" wait)
                         (org-texmacs--worker-request "parse_adapter" parse)
                         (org-texmacs--native-document-wire "native_wire")
                         (org-texmacs--native-call "native_adapter" native)
                         (org-texmacs--native-save-bytes "publication")))
          (apply #'bench-add entry))
        (dotimes (index 3)
          (let ((repeat (1+ index)))
            (dolist (route (if (cl-oddp repeat) '("direct" "include") '("include" "direct")))
              (dolist (format (if (cl-oddp repeat) '("tm" "pdf") '("pdf" "tm")))
                (dolist (temperature '("cold" "warm"))
                  (bench-run (cdr (assoc route sources)) route format temperature repeat)))))))
    (setq bench-enabled nil)
    (dolist (entry bench-advice) (advice-remove (car entry) (cdr entry)))
    (org-texmacs--worker-stop)
    (dolist (entry sources) (when (buffer-live-p (cdr entry)) (kill-buffer (cdr entry))))
    (delete-directory directory t)))
(message "BENCH complete: %d exports" (length bench-rows))
