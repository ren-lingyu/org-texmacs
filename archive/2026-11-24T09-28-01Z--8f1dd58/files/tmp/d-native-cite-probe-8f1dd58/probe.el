;;; probe.el --- Native Cite data flow -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'org)
(require 'ox-texmacs)

(defconst probe-counters
  '(prepared-copy input-own input-finalize document-resolve document-allocate
    input-cite-plan cite-view document-static-labels bibliography-copy
    bibliography-format document-lower worker-request))

(defun probe-report (key value)
  (let ((print-escape-newlines t))
    (princ (format "%S %S\n" key value))))

(defun probe-check (value label)
  (unless value (error "Probe assertion failed: %s" label)))

(defun probe-input (input)
  (let* ((ast (org-texmacs-input-ast input))
         (paths (org-texmacs--model-node-paths ast))
         (info (org-texmacs-input-info input))
         (query (plist-get info :texmacs-org-query))
         (plan (plist-get info :texmacs-cite-plan))
         (res (org-texmacs-input-resolution input)))
    (cl-labels
        ((path (node)
           (let ((value (gethash node paths :missing)))
             (probe-check (not (eq value :missing)) 'mapped-to-owned-ast)
             value))
         (project (pairs)
           (mapcar (lambda (pair) (cons (path (car pair)) (cdr pair))) pairs))
         (targets (pairs)
           (mapcar (lambda (pair) (cons (path (car pair)) (path (cdr pair)))) pairs)))
      (list
       :model-aliases (and (eq ast (org-texmacs-model-ast (org-texmacs-input-model input)))
                           (eq (org-texmacs-input-islands input)
                               (org-texmacs-model-islands (org-texmacs-input-model input))))
       :ast (sort (let (nodes)
                    (maphash (lambda (node where)
                               (push (if (stringp node)
                                         (list where (substring-no-properties node))
                                       (list where (org-element-type node)
                                             (mapcar (lambda (key) (org-element-property key node))
                                                     '(:name :type :key :value :raw-link :label))))
                                     nodes))
                             paths)
                    nodes)
                  (lambda (a b) (string-lessp (prin1-to-string (car a))
                                              (prin1-to-string (car b)))))
       :islands (project (org-texmacs-input-islands input))
       :query-references (project (plist-get query :references))
       :query-notes (mapcar (lambda (pair) (cons (path (car pair)) (path (nth 1 pair))))
                            (plist-get query :footnotes))
       :nodes (mapcar #'path (org-texmacs-resolution-nodes res))
       :targets (targets (org-texmacs-resolution-targets res))
       :labels (project (org-texmacs-resolution-labels res))
       :links (project (org-texmacs-resolution-links res))
       :files (project (org-texmacs-resolution-files res))
       :resolved-notes
       (mapcar (lambda (pair)
                 (list (path (car pair)) (path (nth 1 pair))
                       (path (nth 2 pair)) (nth 3 pair)))
               (org-texmacs-resolution-footnotes res))
       :failure (org-texmacs-resolution-failure res)
       :requests (project (plist-get info :texmacs-cite-requests))
       :usage (list (project (plist-get plan :citations)) (mapcar #'path (plist-get plan :prints))
                    (plist-get plan :keys) (plist-get plan :files) (plist-get plan :style))
       :prefix (plist-get plan :prefix)
       :entries (plist-get plan :entries)
       :sources (org-texmacs-input-bibliography input)
       :output (plist-get info :texmacs-bibliography-output)
       :snapshots
       (mapcar (lambda (snapshot)
                 (list (plist-get snapshot :path) (plist-get snapshot :state)
                       (plist-get snapshot :digest) (plist-member snapshot :text)))
               (plist-get info :texmacs-bibliography-snapshots))))))

(defun probe-identities (left right)
  (let* ((li (org-texmacs-input-info left))
         (ri (org-texmacs-input-info right))
         (lp (plist-get li :texmacs-cite-plan))
         (rp (plist-get ri :texmacs-cite-plan)))
    (append
     (mapcar (lambda (reader) (cons reader (eq (funcall reader left) (funcall reader right))))
             '(org-texmacs-input-model org-texmacs-input-ast org-texmacs-input-islands
               org-texmacs-input-info org-texmacs-input-resolution
               org-texmacs-input-bibliography))
     (mapcar (lambda (key) (cons key (eq (plist-get li key) (plist-get ri key))))
             '(:texmacs-org-query :texmacs-cite-requests
               :texmacs-format-headline-function :texmacs-date-timestamp-text-function
               :texmacs-reference-tag-function))
     (list (cons 'plan (eq lp rp))
           (cons 'failure
                 (eq (org-texmacs-resolution-failure (org-texmacs-input-resolution left))
                     (org-texmacs-resolution-failure (org-texmacs-input-resolution right))))))))

(defun probe-run (bib-file scenario)
  (with-temp-buffer
    (org-mode)
    (insert "#+OPTIONS: toc:nil title:nil author:nil date:nil\n"
            "#+cite_export: texmacs-native plain\n#+bibliography: " bib-file "\n\n")
    (unless (eq scenario 'no-print)
      (insert "Citation [cite:@one].\n\n"))
    (insert "See [[fig-probe]]. Note [fn:probe] again [fn:probe]. Target <<bad>>.\n\n"
            "#+NAME: fig-probe\n#+CAPTION: Probe figure\n"
            "#+begin_figure\n#+begin_texmacs\n(math \"x\")\n#+end_texmacs\n#+end_figure\n\n"
            "#+begin_texmacs\n(label \"org-texmacs-bib-1-one\")\n#+end_texmacs\n\n"
            (if (eq scenario 'no-print) "" "#+print_bibliography:\n\n")
            "[fn:probe] Repeated note text.\n")
    (let* ((org-export-use-babel nil)
           (org-export-filter-parse-tree-functions
            (when (eq scenario 'failure)
              (list (lambda (ast _backend _info)
                      (org-element-map ast 'target
                        (lambda (node) (org-element-put-property node :value "")))
                      ast))))
           (counts (make-hash-table :test #'eq))
           (bib-requests 0)
           (attached (symbol-function 'org-texmacs--input-cite-result))
           (fulfilled (symbol-function 'org-texmacs--prepared-cite-fulfill))
           (source (buffer-string))
           (tick (buffer-chars-modified-tick))
           (original-point (point))
           restores i0 i1 i2 i3 result)
      (unwind-protect
          (progn
            (dolist (name probe-counters)
              (let* ((symbol (intern (format "org-texmacs--%s" name)))
                     (original (symbol-function symbol)))
                (push (cons symbol original) restores)
                (fset symbol (lambda (&rest args)
                               (cl-incf (gethash name counts 0))
                               (when (and (eq name 'worker-request)
                                          (eq (nth 1 args) 'bibliography))
                                 (cl-incf bib-requests))
                               (apply original args)))))
            (cl-letf (((symbol-function 'org-texmacs--input-cite-result)
                       (lambda (input sources output)
                         (let ((result (funcall attached input sources output)))
                           (if output (setq i2 result) (setq i1 result))
                           result)))
                      ((symbol-function 'org-texmacs--prepared-cite-fulfill)
                       (lambda (input)
                         (setq i0 input)
                         (setq i3 (funcall fulfilled input)))))
              (setq result
                    (if (eq scenario 'failure)
                        (org-texmacs-prepare-buffer (current-buffer))
                      (org-texmacs-document-from-buffer (current-buffer)))))
            (probe-check (and (equal source (buffer-string))
                              (= tick (buffer-chars-modified-tick))
                              (= original-point (point))) 'source-invariant)
            (probe-report scenario (mapcar (lambda (key) (cons key (gethash key counts 0)))
                                           probe-counters))
            (probe-report 'real-bibliography-parse-requests bib-requests)
            (if (eq scenario 'no-print)
                (probe-check (and (eq i0 i3) (null i1) (null i2) (zerop bib-requests)
                                  (zerop (gethash 'bibliography-format counts 0))) 'no-print)
              (let* ((views (mapcar #'probe-input (list i0 i1 i2 i3)))
                     (base (car views))
                     (stable '(:model-aliases :ast :islands :query-references :query-notes :nodes
                               :targets :labels :links :files :resolved-notes :failure :requests :usage :prefix)))
                (dolist (view (cdr views))
                  (dolist (key stable)
                    (probe-check (equal (plist-get base key) (plist-get view key)) key)))
                (probe-check (and (plist-get base :model-aliases)
                                  (equal (plist-get base :prefix) "org-texmacs-bib-2")
                                  (= (length (plist-get base :query-notes)) 2)
                                  (equal (cdar (plist-get base :query-notes))
                                         (cdr (cadr (plist-get base :query-notes))))) 'fixture)
                (dolist (view views)
                  (let ((snapshot (car (plist-get view :snapshots))))
                    (probe-check (equal (cl-subseq snapshot 0 3)
                                        (cl-subseq (car (plist-get base :snapshots)) 0 3))
                                 'snapshot-fingerprint)))
                (cl-loop for view in views for n from 0
                         do (probe-report
                             (list 'stage n)
                             (list :prefix (plist-get view :prefix)
                                   :entries (mapcar (lambda (entry) (nth 2 entry))
                                                    (cdr (plist-get view :entries)))
                                   :sources (length (plist-get view :sources))
                                   :output (and (plist-get view :output) t)
                                   :snapshot-text (and (nth 3 (car (plist-get view :snapshots))) t)
                                   :failure (plist-get view :failure))))
                (probe-check (and (= bib-requests 1)
                                  (= (gethash 'bibliography-format counts 0) 1)
                                  (null (plist-get (nth 1 views) :output))
                                  (equal (plist-get (nth 1 views) :entries)
                                         (plist-get (nth 2 views) :entries))
                                  (equal (plist-get (nth 2 views) :output)
                                         (plist-get (nth 3 views) :output))
                                  (null (nth 3 (car (plist-get (nth 3 views) :snapshots)))))
                             'bibliography-stages)
                (cl-loop for left in (list i0 i1 i2) for right in (list i1 i2 i3)
                         for n from 0 do (probe-report (list 'eq n (1+ n))
                                                       (probe-identities left right)))
                (probe-report 'equal-semantic-fields stable)
                (probe-report 'reference-summary
                              (mapcar (lambda (key) (cons key (plist-get base key)))
                                      '(:targets :links :labels :query-notes :resolved-notes))))
              (if (eq scenario 'failure)
                  (let ((err (condition-case error
                                 (progn (org-texmacs-document result) nil)
                               (org-texmacs-document-error error))))
                    (probe-check (and (eq result i3)
                                      (equal (cadr err) "Invalid dedicated target")
                                      (equal (cdr err)
                                             (org-texmacs-resolution-failure
                                              (org-texmacs-input-resolution i3)))
                                      (= bib-requests 1)
                                      (= (gethash 'bibliography-format counts 0) 1)
                                      (= (gethash 'document-lower counts 0) 1)) 'failure-lowering)
                    (probe-report 'independent-lowering-error err))
                (let ((tags (flatten-tree (org-texmacs-document-body result))))
                  (probe-check (cl-every (lambda (tag) (memq tag tags)) '(big-figure cite bib-list))
                               'native-document)))))
        (dolist (entry restores)
          (fset (car entry) (cdr entry)))))))

(let* ((directory (make-temp-file "native-cite-flow-" t))
       (bib-file (expand-file-name "references.bib" directory)))
  (unwind-protect
      (progn
        (with-temp-file bib-file
          (insert "@book{one,author={Ada Example},title={Probe},year={2026},publisher={Press}}\n"))
        (probe-report 'versions (list emacs-version (org-version) org-texmacs-program))
        (dolist (scenario '(document failure no-print))
          (probe-run bib-file scenario))
        (probe-report 'status 'passed))
    (org-texmacs--worker-stop)
    (delete-directory directory t)))
