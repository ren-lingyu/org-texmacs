;;; probe-common.el --- isolated comparison helpers -*- lexical-binding: t; -*-
(require 'oc-csl)
(require 'json)
(defun bc-file (name) (expand-file-name name (getenv "BIB_COMPARE_FIXTURES")))
(defun bc-out () (file-name-directory (getenv "ORG_TEXMACS_TEST_NAMES_FILE")))
(defun bc-cases () (let ((json-array-type 'list) (json-object-type 'alist) (json-key-type 'symbol)) (json-read-file (bc-file "cases.json"))))
(defun bc-json (v)
 (cond ((or (null v) (eq v t) (stringp v) (numberp v)) v)
       ((and (consp v) (keywordp (car v)))
        (let ((h (make-hash-table :test 'equal)))
         (while v (puthash (substring (symbol-name (pop v)) 1) (bc-json (pop v)) h)) h))
       ((listp v) (vconcat (mapcar #'bc-json v)))
       (t (format "%s" v))))
(defun bc-normalize (tree)
 (let ((labels (make-hash-table :test 'equal)) (index 0))
  (cl-labels ((scan (v) (when (consp v)
                (when (and (eq (car v) 'label) (stringp (cadr v)))
                  (let ((name (format "TARGET-%d" (cl-incf index))))
                    (puthash (cadr v) name labels) (puthash (concat "#" (cadr v)) (concat "#" name) labels)))
                (mapc #'scan (cdr v))))
              (rewrite (v) (if (stringp v) (or (gethash v labels) v)
                            (if (consp v) (cons (car v) (mapcar #'rewrite (cdr v))) v))))
   (scan tree) (rewrite tree))))
(defun bc-repeat-view (record)
 (let (out) (while record (let ((key (pop record)) (value (pop record)))
             (unless (eq key :lowered) (setq out (append out (list key value)))))) out))
(defun bc-write (name data) (with-temp-file (expand-file-name name (bc-out)) (let ((json-encoding-pretty-print t)) (insert (json-encode (bc-json data))))))
(defun bc-read (file) (with-temp-buffer (insert-file-contents file) (buffer-string)))
(defun bc-str (data) (let ((print-length nil) (print-level nil) (print-circle t)) (prin1-to-string data)))
(defun bc-view (node)
 (if (stringp node) (substring-no-properties node)
   (list (org-element-type node)
         (mapcar (lambda (p) (cons p (org-element-property p node))) '(:value :name :utf-8 :type :path :use-brackets-p))
         (mapcar #'bc-view (org-element-contents node)))))
(defun bc-count (tag tree)
 (if (consp tree) (+ (if (eq (car tree) tag) 1 0) (apply #'+ (mapcar (lambda (c) (bc-count tag c)) (cdr tree)))) 0))
(defun bc-render (doc name)
 (let ((pdf (expand-file-name (concat name ".pdf") (bc-out))))
  (unless (file-exists-p (expand-file-name (concat name ".tm") (bc-out)))
   (org-texmacs-document-save doc (expand-file-name (concat name ".tm") (bc-out))))
  (unless (file-exists-p pdf) (org-texmacs-document-save-pdf doc pdf))
  (call-process "pdftoppm" nil nil nil "-f" "1" "-singlefile" "-scale-to" "1400" "-png" pdf (expand-file-name name (bc-out)))
  (org-texmacs-test--pdf-text pdf)))
(defun bc-run (fixture route style &optional factory)
 (let* ((key (alist-get 'id fixture)) (extension (if (equal route "json") "json" "bib"))
        (file (bc-file (concat key "." extension))) trace rendered item-title item-data internal-title raw-title created input
        (org-export-use-babel nil) (prepared 0) (filtered 0)
        (org-export-before-processing-functions (list (lambda (_) (cl-incf prepared))))
        (org-export-filter-parse-tree-functions (list (lambda (tree _backend _info) (cl-incf filtered) tree)))
        (original-factory (symbol-function 'citeproc-hash-itemgetter-from-any))
        (create (symbol-function 'citeproc-create))
        (processor (symbol-function 'org-cite-csl--processor))
        (blt (symbol-function 'citeproc-blt--to-csl-title))
        (parse-value (symbol-function 'citeproc-proc--parse-csl-var-val))
        (bib (symbol-function 'citeproc-render-bib))
        (cite (symbol-function 'citeproc-render-citations))
        (record (list :case key :category (alist-get 'category fixture) :route route :style style)))
  (with-temp-buffer
   (org-mode)
   (insert (format "#+OPTIONS: toc:nil title:nil author:nil date:nil e:t ^:t tex:t\n#+bibliography: %s\n#+cite_export: csl %s\n[cite:@%s]\n#+print_bibliography:\n" file (bc-file (concat style ".csl")) key))
   (let ((source (buffer-string)))
    (condition-case err
     (cl-letf (((symbol-function 'org-cite-csl--processor)
                (lambda (info)
                 (cl-letf (((symbol-function 'citeproc-hash-itemgetter-from-any)
                            (if (and factory (org-export-derived-backend-p (plist-get info :back-end) 'texmacs))
                                factory original-factory)))
                   (funcall processor info))))
               ((symbol-function 'citeproc-create)
                (lambda (s getter locale &rest opts)
                 (setq created (list s getter locale opts))
                 (apply create s
                   (lambda (ids) (let ((result (funcall getter ids)))
                     (when (listp ids) (setq item-title (alist-get 'title (cdar result)) item-data (bc-str result))) result)) locale opts)))
               ((symbol-function 'citeproc-blt--to-csl-title)
                (lambda (&rest args) (let ((result (apply blt args))) (unless raw-title (setq raw-title (car args))) (push (list :input (car args) :output result) trace) result)))
               ((symbol-function 'citeproc-proc--parse-csl-var-val)
                (lambda (rep var proc)
                 (let ((result (funcall parse-value rep var proc)))
                  (when (eq var 'title) (setq internal-title (bc-str result))) result)))
               ((symbol-function 'citeproc-render-bib)
                (lambda (&rest args) (let ((result (apply bib args))) (push (list :kind "bibliography" :value (bc-str result)) rendered) result)))
               ((symbol-function 'citeproc-render-citations)
                (lambda (&rest args) (let ((result (apply cite args))) (push (list :kind "citation" :value (bc-str result)) rendered) result))))
      (setq input (org-texmacs-prepare-buffer (current-buffer)))
      (setq record (append record (list :raw-title raw-title :item-title item-title :item-data item-data :internal-title internal-title :trace trace :rendered rendered
                    :ast (bc-str (bc-view (org-texmacs-input-ast input)))
                    :islands (bc-str (org-texmacs-input-islands input)))))
      (condition-case failure
       (let* ((doc (org-texmacs-document input)) (tree (org-texmacs-document-body doc)))
        (setq record (append record (list :lowered (bc-str tree) :normalized-lowered (bc-str (bc-normalize tree)) :math-count (bc-count 'math tree))))
        (when (and (not (equal route "bib")) (member key '("plain" "chinese" "math-unicode" "bare-cdot" "stm-alpha" "stm-rsub" "stm-frac" "stm-rsub-control")))
         (setq record (append record (list :pdf-text (bc-render doc (concat route "-" style "-" key)))))))
       (error (setq record (append record (list :lower-error (bc-str failure)))))))
     (error (setq record (append record (list :prepare-error (bc-str err))))))
    (should (equal source (buffer-string)))))
  (should (= prepared 1)) (should (= filtered 1))
  (should (eq original-factory (symbol-function 'citeproc-hash-itemgetter-from-any)))
  (message "CASE %s %s %s error=%s" route style key (or (plist-get record :prepare-error) (plist-get record :lower-error)))
  (cons record created)))
