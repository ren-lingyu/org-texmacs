;;; getter.el --- fixture-only getter protocol and standard handoff -*- lexical-binding: t; -*-
(defun bc-getter (pairs)
 (let ((cache (make-hash-table :test 'equal)))
  (dolist (pair pairs)
   (let ((key (car pair)) (item (cdr pair)))
    (unless (and (stringp key) (> (length key) 0) (listp item)
                 (stringp (alist-get 'type item)) (stringp (alist-get 'title item)))
      (error "Invalid fixture item"))
    (when (gethash key cache) (error "Duplicate fixture key: %s" key))
    (puthash key (copy-tree item) cache)))
  (lambda (request)
   (cond ((eq request 'itemids) (sort (hash-table-keys cache) #'string-lessp))
         ((and (listp request) (cl-every #'stringp request))
          (mapcar (lambda (key) (let ((item (gethash key cache)))
                    (unless item (error "Missing fixture key: %s" key))
                    (cons (copy-sequence key) (copy-tree item)))) request))
         (t (error "Invalid fixture request"))))))
(defun bc-fixture-factory (files &optional no-sentcase)
 (let ((entries (make-hash-table :test 'equal)) (strings (make-hash-table :test 'equal)) pairs)
  (dolist (file (if (listp files) files (list files)))
   (with-temp-buffer (insert-file-contents file) (bibtex-set-dialect 'biblatex t)
     (citeproc-itemgetters--parsebib-buffer entries strings)))
  (maphash
   (lambda (key entry)
    (let* ((item (citeproc-blt-entry-to-csl entry nil no-sentcase))
           (baseline (copy-tree item))
           (fixture (cl-find key (bc-cases) :key (lambda (c) (alist-get 'id c)) :test #'equal)))
     ;; The fixture category is the experiment's declared target, not a proposed
     ;; general LaTeX detector or a replacement BibLaTeX parser.
     (when (member (alist-get 'category fixture) '("latex" "stm"))
       (setf (alist-get 'title item) (alist-get "title" entry nil nil #'equal)))
     (should (equal (assq-delete-all 'title baseline) (assq-delete-all 'title (copy-tree item))))
     (push (cons key item) pairs))) entries)
  (bc-getter pairs)))
(ert-deftest bibliography-comparison-getter ()
 (org-texmacs-test--with-worker
  (let* ((item '((type . "article-journal") (title . "Sentinel")))
         (getter (bc-getter (list (cons "key" item))))
         (original (symbol-function 'citeproc-hash-itemgetter-from-any)) records)
   (should (equal (funcall getter 'itemids) '("key")))
   (should (equal (funcall getter '("key")) (funcall getter '("key"))))
   (should-error (funcall getter '("missing")))
   (should-error (funcall getter '(12)))
   (should-error (funcall getter 'unknown))
   (should-error (bc-getter (list (cons "key" item) (cons "key" item))))
   (should-error (bc-getter '(("key" (type . "article-journal") (title . 12)))))
   (let ((copy (funcall getter '("key")))) (setcdr (assq 'title (cdar copy)) "changed"))
   (should (equal (alist-get 'title (cdar (funcall getter '("key")))) "Sentinel"))
   (dolist (fixture (bc-cases))
    (dolist (style '("plain" "italic"))
     (let* ((first (bc-run fixture "getter" style #'bc-fixture-factory))
            (one (car first)) (two (car (bc-run fixture "getter" style #'bc-fixture-factory))))
      (should (equal (bc-repeat-view one) (bc-repeat-view two)))
      (push (append one '(:repeat-equal t)) records)
      (when (and (equal (alist-get 'id fixture) "math-frac") (equal style "plain"))
       (let* ((args (cdr first))
              (proc (apply #'citeproc-create (nth 0 args) (nth 1 args) (nth 2 args) (nth 3 args)))
              (citation (citeproc-citation-create :cites (list (list (cons 'id "math-frac"))))))
        (citeproc-append-citations (list citation) proc)
        (bc-write "independent-processor.json" (list :citations (bc-str (citeproc-render-citations proc 'org))
               :bibliography (bc-str (citeproc-render-bib proc 'org)))))))))
   (should (eq original (symbol-function 'citeproc-hash-itemgetter-from-any)))
   ;; A new standard HTML transaction uses the original getter after the scope;
   ;; the experimental binding also dispatches by INFO backend inside nested calls.
   (with-temp-buffer
    (org-mode)
    (insert (format "#+bibliography: %s\n#+cite_export: csl %s\n[cite:@math-alpha-sub]\n#+print_bibliography:\n"
              (bc-file "math-alpha-sub.bib") (bc-file "plain.csl")))
    (let ((html (org-export-as 'html nil nil t)))
     (should (string-search "$_i$" html))
     (bc-write "html-control.json" (list :html html :factory-restored t))))
   (let ((duplicate (expand-file-name "duplicate.bib" default-directory)))
    (with-temp-file duplicate
     (insert "@book{duplicate,title={First},year={2025}}\n@book{duplicate,title={Second},year={2026}}\n"))
    (let ((getter (bc-fixture-factory duplicate)))
     (bc-write "duplicate-bib-control.json" (list :keys (funcall getter 'itemids)
                  :items (bc-str (funcall getter '("duplicate")))
                  :note "Parsebib hash coalesces duplicate source keys before getter validation"))))
   (let ((nested-html nil))
    (bc-run (car (bc-cases)) "getter" "plain"
     (lambda (files &optional no-case)
      (with-temp-buffer
       (org-mode)
       (insert (format "#+bibliography: %s\n#+cite_export: csl %s\n[cite:@math-alpha-sub]\n#+print_bibliography:\n"
                        (bc-file "math-alpha-sub.bib") (bc-file "plain.csl")))
       (let ((org-export-before-processing-functions nil)
             (org-export-filter-parse-tree-functions nil))
        (setq nested-html (org-export-as 'html nil nil t))))
      (bc-fixture-factory files no-case)))
    (should (string-search "$_i$" nested-html))
    (bc-write "nested-html-control.json" (list :html nested-html :uses-original-getter t)))
   (let ((getter (bc-getter '(("key" (type . "article-journal") (title . "Sentinel"))))) controls)
    (dolist (request '(itemids ("key") ("key" "key") ("missing") (12) unknown))
     (let ((one (condition-case err (bc-str (funcall getter request)) (error (bc-str err))))
           (two (condition-case err (bc-str (funcall getter request)) (error (bc-str err)))))
      (should (equal one two))
      (push (list :request (bc-str request) :output one :repeat-equal t) controls)))
    (dolist (pairs '((("key" (type . "book") (title . "One")) ("key" (type . "book") (title . "Two")))
                     (("key" (type . "book") (title . 12)))))
     (let ((one (condition-case err (bc-str (bc-getter pairs)) (error (bc-str err))))
           (two (condition-case err (bc-str (bc-getter pairs)) (error (bc-str err)))))
      (should (equal one two))
      (push (list :construction (bc-str pairs) :output one :repeat-equal t) controls)))
    (bc-write "getter-protocol.json" (nreverse controls)))
   (bc-write "getter-results.json" (nreverse records)))))
