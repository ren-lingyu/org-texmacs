;;; native.el --- C native parse/format, no Org preparation -*- lexical-binding: t; -*-
(ert-deftest bibliography-comparison-native ()
 (org-texmacs-test--with-worker
  (let (records bodies unicode-bodies)
   (dolist (fixture (bc-cases))
    (let* ((key (alist-get 'id fixture)) (prefix (concat "probe-" key))
           (source (bc-read (bc-file (concat key ".bib"))))
           (record (list :case key :category (alist-get 'category fixture) :source source)))
     (condition-case err
      (let* ((parsed (org-texmacs--worker-request source 'bibliography))
             (again (org-texmacs--worker-request source 'bibliography))
             (entries (cons 'document (cl-remove-if-not (lambda (n) (and (consp n) (eq (car n) 'bib-entry))) (cdr parsed))))
             (plan (list :prefix prefix :keys (list key) :entries entries))
             (formatted (org-texmacs--bibliography-format plan))
             (again-format (org-texmacs--bibliography-format plan))
             (body (nth 3 formatted)))
       (should (equal parsed again)) (should (equal formatted again-format))
       (setq record (append record (list :parsed (bc-str parsed) :formatted (bc-str body)
                     :parsed-math (bc-count 'math parsed) :formatted-math (bc-count 'math body) :repeat-equal t)))
       (push `(with-bib ,prefix (concat ,(concat "CASE " key ": Reference ") (cite ,key) ".")) bodies)
       (push `(with-bib ,prefix ,body) bodies)
       (when (member key '("chinese" "combining" "greek-unicode" "math-unicode"))
        (push `(with-bib ,prefix ,body) unicode-bodies)))
      (error (setq record (append record (list :error (bc-str err))))))
     (message "NATIVE %s error=%s" key (plist-get record :error)) (push record records)))
   (let* ((body (cons 'document (nreverse bodies)))
          (paths (cl-loop for i from 0 below (length (cdr body)) collect (list i)))
          (doc (org-texmacs--document-create :body body :stm-paths paths)))
    (condition-case err
     (progn (bc-render doc "native-all")
       (call-process "pdftoppm" nil nil nil "-scale-to" "1600" "-png" (expand-file-name "native-all.pdf" (bc-out)) (expand-file-name "native-page" (bc-out))))
     (error (push (list :render-error (bc-str err)) records))))
   (let* ((source "@book{z,title={Zulu title},author={Zulu, Zoe},year={2026}}\n@book{a,title={Alpha title},author={Alpha, Ada},year={2026}}\n@book{m,title={Middle title},author={Middle, Max},year={2026}}")
          (parsed (org-texmacs--worker-request source 'bibliography))
          (plan (list :prefix "sort" :keys '("z" "a" "m") :entries parsed))
          (result (org-texmacs--bibliography-format plan))
          (doc (org-texmacs--document-create
                :body `(document (with-bib "sort" (concat "Order z,a,m: " (cite "z" "a" "m")))
                                 (with-bib "sort" ,(nth 3 result))) :stm-paths '((0) (1)))))
    (should (equal result (org-texmacs--bibliography-format plan)))
    (bc-write "native-sorting.json" (list :parsed (bc-str parsed) :formatted (bc-str result)
                   :pdf-text (bc-render doc "native-sorting"))))
   (org-texmacs--worker-stop)
   (let* ((org-texmacs-program (getenv "BIB_COMPARE_FANDOL_PROGRAM"))
          (body (cons 'document (cons "CONTROL 中文 é é" (nreverse unicode-bodies))))
          (doc (org-texmacs--document-create :body body :initial '(("language" . "chinese"))
                   :stm-paths (cl-loop for i from 1 below (length (cdr body)) collect (list i)))))
     (bc-write "native-font-control.json" (list :body (bc-str body)
                :pdf-text (bc-render doc "native-font-control"))))
   (bc-write "native-results.json" (nreverse records)))))
