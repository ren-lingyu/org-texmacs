(use-modules (bibtex bib-utils) (generic document-edit))
(define loader-calls 0)
(define (checked-style style)
  (let ((name (org-texmacs-bibliography-style style)))
    (if (not name) (error "Unknown or unreadable style/base" style))
    (set! loader-calls (+ 1 loader-calls))
    (module-provide '(bibtex plain))
    (module-provide (list 'bibtex (string->symbol name)))
    name))
(define (attempt style)
  (let ((before loader-calls))
    (catch #t
           (lambda () (list style 'ok (checked-style style) (- loader-calls before)))
           (lambda args (list style 'error (object->string args) (- loader-calls before))))))
(define (run-loader output fixtures)
  (let* ((catalog (bib-standard-styles))
         (normal (map attempt '("plain" "alpha" "abbrv" "tm-alpha" "unknown-style" "../plain")))
         (old-path (getenv "GUILE_LOAD_PATH")) (missing #f) (dependency #f)
         (saved (list bib-current-prefix bib-style bib-default-style))
         (restored #f))
    (mkdir (string-append fixtures "bibtex"))
    (copy-file (list->module '(bibtex alpha)) (string-append fixtures "bibtex/alpha.scm"))
    (copy-file (list->module '(bibtex bib-utils)) (string-append fixtures "bibtex/bib-utils.scm"))
    (dynamic-wind
        (lambda () (setenv "GUILE_LOAD_PATH" "/missing-native-loader-fixture"))
        (lambda () (set! missing (attempt "plain"))
                (setenv "GUILE_LOAD_PATH" fixtures)
                (set! dependency (attempt "alpha")))
        (lambda () (if old-path (setenv "GUILE_LOAD_PATH" old-path) (unsetenv "GUILE_LOAD_PATH"))))
    ;; A malformed wire tree fails inside formatting's dynamic-wind.
    (org-texmacs-reply '(format-bibliography 1 "probe" bad-tree "alpha"))
    (set! restored (if (equal? saved (list bib-current-prefix bib-style bib-default-style))
                       'restored 'changed))
    (call-with-output-file output (lambda (p) (write (list catalog normal missing (attempt "plain") dependency restored) p) (newline p)))))
